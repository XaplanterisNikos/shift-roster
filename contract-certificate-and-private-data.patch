+		var lh = AttendanceSheetTexts.Letterhead(texts);
+		for (var i = 0; i < lh.Length; i++)
+			Merge(ws, lh0 + i, CertIndex, lh0 + i, CertFirst, lh[i].Text, 9, lh[i].Bold, left, null);
