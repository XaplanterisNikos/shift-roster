@page "/employee-parameters"
@using Vardiologio.Application.Parameters

@* Employee lookups (ειδικότητες / συμβάσεις / θέσεις) as tabs over one reusable editor.
   A tab's editor is created when the tab opens and dropped when it closes, so each tab
   starts clean. Tab styles: "Report texts" block in app.css. *@

<div class="page-head">
    <div>
        <MudText Typo="Typo.h4">Παράμετροι Εργαζομένων</MudText>
        <MudText Typo="Typo.body2" Class="page-sub">Οι ειδικότητες, οι συμβάσεις και οι θέσεις που επιλέγονται στην καρτέλα κάθε εργαζομένου.</MudText>
    </div>
</div>

<MudTabs Elevation="0" SliderColor="Color.Primary" Class="report-tabs" TabPanelsClass="report-tab-panel">
    @foreach (var tab in Tabs)
    {
        <MudTabPanel Text="@tab.Title">
            <LookupEditor Kind="tab.Kind" />
        </MudTabPanel>
    }
</MudTabs>

@code {
    /// <summary>Tab order and titles; the Kind is what LookupEditor works on.</summary>
    private static readonly (LookupKind Kind, string Title)[] Tabs =
    {
        (LookupKind.Speciality, "Ειδικότητες"),
        (LookupKind.EmploymentType, "Συμβάσεις"),
        (LookupKind.WorkPosition, "Θέσεις")
    };
}
