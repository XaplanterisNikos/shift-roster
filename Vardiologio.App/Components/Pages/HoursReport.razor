@page "/hours-report"
@using System.Diagnostics
@using System.IO
@using Vardiologio.Application.Files
@using Vardiologio.Application.Hours
@using Vardiologio.Application.Logging
@using Vardiologio.Application.ReportColors
@using Vardiologio.Application.Reports
@using Vardiologio.Domain.Enums
@inject IHoursReportService HoursReportService
@inject IExcelReportRenderer Excel
@inject IPdfReportRenderer Pdf
@inject IReportFileStore FileStore
@inject IErrorLog ErrorLog
@inject ISnackbar Snackbar

@* Monthly hours report: every active employee's declared / paid / excess hours per pay
   category, with the monthly limits applied (same calculation as the entry screen).
   Show on screen, save+open as Excel or PDF, or preview the PDF inline (as in Export.razor). *@
<div class="page-head">
    <div>
        <MudText Typo="Typo.h4">Εξαγωγή Αναφοράς Ωρών Μηνιαία</MudText>
        <MudText Typo="Typo.body2" Class="page-sub">Δηλωμένες, πληρωτέες και περισσευούμενες ώρες ανά κατηγορία, με τα μηνιαία όρια.</MudText>
    </div>
</div>

@* Month, preview and export buttons (Shared/ReportToolbar.razor). *@
<ReportToolbar @bind-Year="year" @bind-Month="month" Busy="busy"
               OnShow="ShowAsync" OnPreview="PreviewPdf" PreviewText="Προεπισκόπηση PDF" OnExcel="ExportExcel" OnPdf="ExportPdf" />

@if (error is not null)
{
    <MudAlert Severity="Severity.Error" Dense="true" Class="report-alert">@error</MudAlert>
}

@if (model is not null)
{
    @* On-screen version of the report; over-limit cells highlighted as in the files.
       "hours-scroll": the table scrolls inside its own box, with the two header rows and the
       name column staying in view (rules in the "Reports" block of app.css). *@
    <div class="hours-scroll">
        @* The report's colours (Παράμετροι → Αναφορών → Χρώματα), read by the "hours-report" rules in app.css. *@
        <table class="hours-report" style="--hours-cat:@(model.Colors[ReportColorCatalog.HoursCategories]);--hours-over:@(model.Colors[ReportColorCatalog.HoursExcess])">
            <thead>
                <tr>
                    <th rowspan="2" class="pin-index">Α/Α</th>
                    <th rowspan="2" class="pin-name">Ονοματεπώνυμο</th>
                    <th rowspan="2">Ειδικότητα</th>
                    @foreach (var cat in Categories)
                    {
                        <th colspan="3">@HoursLabels.Category(cat) (όριο @Num(model.Limits[cat]))</th>
                    }
                </tr>
                <tr>
                    @for (int i = 0; i < Categories.Length; i++)
                    {
                        <th>Δηλ.</th>
                        <th>Πληρ.</th>
                        <th>Περ.</th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var r in model.Rows)
                {
                    <tr class="@(r.HasExcess ? "has-over" : "")">
                        <td class="pin-index">@r.Index</td>
                        <td class="lft pin-name">@r.LastName @r.FirstName</td>
                        <td class="lft">@r.Speciality</td>
                        @foreach (var h in r.Hours)
                        {
                            <td>@Blank(h.Declared)</td>
                            <td>@Blank(h.Paid)</td>
                            <td class="@(h.Excess > 0 ? "over" : "")">@Blank(h.Excess)</td>
                        }
                    </tr>
                }
                <tr class="totals">
                    <td colspan="3" class="lft pin-total">Σύνολα</td>
                    @foreach (var cat in Categories)
                    {
                        <td>@Blank(model.Total(cat, h => h.Declared))</td>
                        <td>@Blank(model.Total(cat, h => h.Paid))</td>
                        <td>@Blank(model.Total(cat, h => h.Excess))</td>
                    }
                </tr>
            </tbody>
        </table>
    </div>
    <MudText Typo="Typo.body2" Class="report-note">
        Αργίες μήνα: @model.HolidaysInMonth. Προς συμπλήρωση + Αργίας: κοινό όριο @Num(model.CombinedLimit),
        κόβεται πρώτα το «Προς συμπλήρωση».
    </MudText>
}

@if (pdfDataUri is not null)
{
    <PdfPreview Data="@pdfDataUri" />
}

@code {
    private static readonly HourCategory[] Categories = Enum.GetValues<HourCategory>();

    private int year = DateTime.Today.Year;
    private int month = DateTime.Today.Month;
    private bool busy;
    private string? error, pdfDataUri;
    private HoursReportModel? model;

    /// <summary>
    /// The page opens with the current month already shown. Done after the first render, so
    /// the page appears at once and the report follows; for another month the user picks it
    /// and presses the button.
    /// </summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        await ShowAsync();
        StateHasChanged();
    }

    /// <summary>Builds the report and shows it on screen.</summary>
    private async Task ShowAsync()
    {
        busy = true; error = null; pdfDataUri = null;
        await ShowBusyAsync();
        try { model = await HoursReportService.BuildAsync(year, month); }
        catch (Exception ex) { Fail("Show", ex); }
        finally { busy = false; }
    }

    private async Task ExportExcel() => await SaveAndOpen(m => Excel.Render(m), "xlsx");
    private async Task ExportPdf() => await SaveAndOpen(m => Pdf.Render(m), "pdf");

    // Build the model, render to bytes, save to Documents\Vardiologio, then open with the default app.
    private async Task SaveAndOpen(Func<HoursReportModel, byte[]> render, string ext)
    {
        busy = true; error = null;
        await ShowBusyAsync();
        try
        {
            model = await HoursReportService.BuildAsync(year, month);
            var bytes = render(model);
            var path = await FileStore.SaveAsync(ReportFolder.MonthlyHours, year, month, $"Monthly_Hours_{year}_{month:00}.{ext}", bytes);
            Process.Start(new ProcessStartInfo(path) { UseShellExecute = true });
            Snackbar.ReportSaved(path);
        }
        catch (Exception ex) { Fail("Excel/PDF export", ex); }
        finally { busy = false; }
    }

    // Build the PDF in memory and show it inline (no file written).
    private async Task PreviewPdf()
    {
        busy = true; error = null; pdfDataUri = null;
        await ShowBusyAsync();
        try
        {
            model = await HoursReportService.BuildAsync(year, month);
            pdfDataUri = "data:application/pdf;base64," + Convert.ToBase64String(Pdf.Render(model));
        }
        catch (Exception ex) { Fail("PDF preview", ex); }
        finally { busy = false; }
    }

    /// <summary>Hours as "6,5" / "120" (current culture).</summary>
    private static string Num(decimal hours) => hours.ToString("0.##");

    /// <summary>Like Num but empty for zero, to keep the table readable.</summary>
    private static string Blank(decimal hours) => hours == 0 ? "" : Num(hours);

    /// <summary>
    /// Draws the progress bar before the report work starts: building and rendering a report
    /// keeps the UI thread busy, so without this pause the bar would never be seen.
    /// </summary>
    private async Task ShowBusyAsync()
    {
        StateHasChanged();
        await Task.Delay(1);
    }

    /// <summary>Logs the error (Documents\Vardiologio\Logs) and shows what went wrong on the page.</summary>
    private void Fail(string action, Exception ex)
    {
        ErrorLog.Error($"Hours report / {action}", ex);
        error = ex.Message;
    }
}
