@page "/shift-table"
@using System.Diagnostics
@using Vardiologio.Application.Files
@using Vardiologio.Application.Logging
@using Vardiologio.Application.Reports
@inject IShiftTableService ShiftTableService
@inject IExcelReportRenderer Excel
@inject IPdfReportRenderer Pdf
@inject IReportFileStore FileStore
@inject IErrorLog ErrorLog
@inject ISnackbar Snackbar

@* Official monthly shift table ("ΠΙΝΑΚΑΣ ΒΑΡΔΙΩΝ ΕΡΓΑΣΙΑΣ ΠΡΟΣΩΠΙΚΟΥ"), one A3 landscape page.
   The preview is the PDF itself (exactly what gets printed). *@
<div class="page-head">
    <div>
        <MudText Typo="Typo.h4">Πίνακας Βαρδιών Εργασίας</MudText>
        <MudText Typo="Typo.body2" Class="page-sub">Το επίσημο έντυπο του μήνα, σε μία σελίδα Α3.</MudText>
    </div>
</div>

@* Month, preview and export buttons (Shared/ReportToolbar.razor). *@
<ReportToolbar @bind-Year="year" @bind-Month="month" Busy="busy"
               OnPreview="PreviewAsync" OnExcel="ExportExcelAsync" OnPdf="ExportPdfAsync" />

@if (error is not null)
{
    <MudAlert Severity="Severity.Error" Dense="true" Class="report-alert">@error</MudAlert>
}

@if (pdfDataUri is not null)
{
    <PdfPreview Data="@pdfDataUri" />
}

@code {
    private int year = DateTime.Today.Year;
    private int month = DateTime.Today.Month;
    private bool busy;
    private string? error, pdfDataUri;

    /// <summary>
    /// The page opens with the current month already shown. Done after the first render, so
    /// the page appears at once and the report follows; for another month the user picks it
    /// and presses the button.
    /// </summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        await PreviewAsync();
        StateHasChanged();
    }

    /// <summary>Renders the table to PDF in memory and shows it inline (no file written).</summary>
    private async Task PreviewAsync()
    {
        busy = true; error = null; pdfDataUri = null;
        await ShowBusyAsync();
        try
        {
            var model = await ShiftTableService.BuildAsync(year, month);
            pdfDataUri = "data:application/pdf;base64," + Convert.ToBase64String(Pdf.Render(model));
        }
        catch (Exception ex) { Fail("Preview", ex); }
        finally { busy = false; }
    }

    private Task ExportExcelAsync() => ExportAsync(m => Excel.Render(m), "xlsx");
    private Task ExportPdfAsync() => ExportAsync(m => Pdf.Render(m), "pdf");

    /// <summary>
    /// Builds the table, writes Shift_Table_yyyy_MM under Reports\Shift-Table\&lt;month&gt;
    /// and opens it with the default application.
    /// </summary>
    private async Task ExportAsync(Func<ShiftTableModel, byte[]> render, string ext)
    {
        busy = true; error = null;
        await ShowBusyAsync();
        try
        {
            var model = await ShiftTableService.BuildAsync(year, month);
            var path = await FileStore.SaveAsync(ReportFolder.ShiftTable, year, month, $"Shift_Table_{year}_{month:00}.{ext}", render(model));
            Process.Start(new ProcessStartInfo(path) { UseShellExecute = true });
            Snackbar.ReportSaved(path);
        }
        catch (Exception ex) { Fail("Excel/PDF export", ex); }
        finally { busy = false; }
    }

    /// <summary>
    /// Draws the progress bar before the report work starts: building and rendering a report
    /// keeps the UI thread busy, so without this pause the bar would never be seen.
    /// </summary>
    private async Task ShowBusyAsync()
    {
        StateHasChanged();
        await Task.Delay(1);
    }

    /// <summary>Logs the error (Documents\Vardiologio\Logs) and shows what went wrong on the page.</summary>
    private void Fail(string action, Exception ex)
    {
        ErrorLog.Error($"Shift table / {action}", ex);
        error = ex.Message;
    }
}
