@page "/overtime-certificate"
@using System.Diagnostics
@using System.Globalization
@using System.IO
@using Vardiologio.Application.Files
@using Vardiologio.Application.Logging
@using Vardiologio.Application.Printing
@using Vardiologio.Application.Reports
@using Vardiologio.Application.ShiftEntry
@inject IOvertimeCertificateService CertificateService
@inject IShiftEntryService ShiftService
@inject IExcelReportRenderer Excel
@inject IPdfReportRenderer Pdf
@inject IReportFileStore FileStore
@inject IPdfPrinter Printer
@inject IErrorLog ErrorLog
@inject ISnackbar Snackbar

@* Individual overtime certificate ("ΠΙΣΤΟΠΟΙΗΣΗ ΥΠΕΡΩΡΙΑΚΗΣ ΚΑΙ ΛΟΙΠΗΣ ΕΡΓΑΣΙΑΣ") of one employee
   for one month. The preview is the PDF itself (exactly what gets printed); Excel / PDF write
   one file for the selected employee. "Εκτυπώσεις" opens the batch list (BatchPrintPanel):
   the ticked employees are printed one after the other on the printer chosen once, each
   previewed and saved as its PDF first, with "3 από 20" on the button. *@
<div class="page-head">
    <div>
        <MudText Typo="Typo.h4">Εξαγωγή Βεβαίωσης Ατομικής</MudText>
        <MudText Typo="Typo.body2" Class="page-sub">Πιστοποίηση υπερωριακής και λοιπής εργασίας ενός εργαζομένου.</MudText>
    </div>
</div>

<ReportToolbar @bind-Year="year" @bind-Month="month" Busy="busy" Disabled="@(employeeId == 0)"
               OnPreview="PreviewAsync" OnExcel="ExportExcelAsync" OnPdf="ExportPdfAsync"
               OnBatch="ToggleBatch" BatchText="@batchText">
    <EmployeePicker Employees="employees" @bind-Value="employeeId" Class="report-employee" />
</ReportToolbar>

@if (batchOpen)
{
    <BatchPrintPanel Employees="employees" Subtitle="@BatchMonth" OnPrint="PrintBatchAsync" OnClose="ToggleBatch" />
}

@if (error is not null)
{
    <MudAlert Severity="Severity.Error" Dense="true" Class="report-alert">@error</MudAlert>
}

@if (pdfDataUri is null && error is null && !busy && !batchOpen)
{
    <MudPaper Elevation="0" Class="empty-state">
        <MudIcon Icon="@Icons.Material.Rounded.PersonSearch" Size="Size.Large" />
        <MudText Typo="Typo.body1">Επιλέξτε μήνα και εργαζόμενο και πατήστε «Προεπισκόπηση».</MudText>
    </MudPaper>
}

@if (pdfDataUri is not null)
{
    <PdfPreview Data="@pdfDataUri" />
}

@code {
    private IReadOnlyList<EmployeeListItem> employees = Array.Empty<EmployeeListItem>();
    private int year = DateTime.Today.Year;
    private int month = DateTime.Today.Month;
    private int employeeId;
    private bool busy;
    private string? error, pdfDataUri;

    /// <summary>The batch list is open under the toolbar.</summary>
    private bool batchOpen;

    /// <summary>Text of the batch button while a batch runs ("3 από 20"); null otherwise.</summary>
    private string? batchText;

    /// <summary>Last PDF saved by the batch: its folder opens from the closing message.</summary>
    private string? batchSaved;

    private static readonly CultureInfo El = CultureInfo.GetCultureInfo("el-GR");

    /// <summary>Loads the active employees for the picker.</summary>
    protected override async Task OnInitializedAsync()
        => employees = await ShiftService.GetEmployeesAsync();

    /// <summary>Renders the certificate to PDF in memory and shows it inline (no file written).</summary>
    private async Task PreviewAsync()
    {
        busy = true; error = null; pdfDataUri = null;
        await ShowBusyAsync();
        try
        {
            var model = await CertificateService.BuildAsync(employeeId, year, month);
            pdfDataUri = "data:application/pdf;base64," + Convert.ToBase64String(Pdf.Render(model));
        }
        catch (Exception ex) { Fail("Preview", ex); }
        finally { busy = false; }
    }

    /// <summary>Opens or closes the batch list; it opens with nothing ticked.</summary>
    private void ToggleBatch() => batchOpen = !batchOpen;

    /// <summary>Month of the batch, for the list's subtitle.</summary>
    private string BatchMonth => new DateTime(year, month, 1).ToString("MMMM yyyy", El);

    /// <summary>
    /// Prints the ticked employees: the printer is chosen once (cancel = nothing happens, the list
    /// stays open), the list closes, and each certificate is previewed, saved as PDF and printed
    /// before the next one. Failures are logged and listed at the end; the batch goes on.
    /// </summary>
    private async Task PrintBatchAsync(IReadOnlyList<EmployeeListItem> chosen)
    {
        if (Printer.ChoosePrinter() is not { } target) return;

        batchOpen = false; busy = true; error = null; batchSaved = null;
        var result = await BatchPrint.RunAsync(chosen, e => e.Display, ShowBatchProgressAsync,
            MakeBatchPdfAsync, target,
            (e, ex) => ErrorLog.Error($"Overtime certificate / Batch print {e.Display}", ex));
        busy = false; batchText = null;
        Snackbar.BatchPrinted(result, chosen.Count, batchSaved);
    }

    /// <summary>Shows "n από total" on the batch button and lets the page draw it.</summary>
    private async Task ShowBatchProgressAsync(int number, int total)
    {
        batchText = $"{number} από {total}";
        await ShowBusyAsync();
    }

    /// <summary>
    /// One certificate of the batch: built, shown as the preview, saved like the PDF export
    /// (without opening it), and returned for the printer.
    /// </summary>
    private async Task<byte[]> MakeBatchPdfAsync(EmployeeListItem employee)
    {
        var model = await CertificateService.BuildAsync(employee.Id, year, month);
        var pdf = Pdf.Render(model);
        pdfDataUri = "data:application/pdf;base64," + Convert.ToBase64String(pdf);
        await ShowBusyAsync();
        batchSaved = await FileStore.SaveAsync(ReportFolder.OvertimeCertificate, year, month, FileName(model, "pdf"), pdf);
        return pdf;
    }

    private Task ExportExcelAsync() => ExportAsync(m => Excel.Render(m), "xlsx");
    private Task ExportPdfAsync() => ExportAsync(m => Pdf.Render(m), "pdf");

    /// <summary>
    /// Builds the certificate, writes Certificate_SURNAME_yyyy_MM (Latin characters) under
    /// Reports\Overtime-Certificate\&lt;month&gt; and opens it with the default application.
    /// </summary>
    private async Task ExportAsync(Func<OvertimeCertificateModel, byte[]> render, string ext)
    {
        busy = true; error = null;
        await ShowBusyAsync();
        try
        {
            var model = await CertificateService.BuildAsync(employeeId, year, month);
            var path = await FileStore.SaveAsync(ReportFolder.OvertimeCertificate, year, month, FileName(model, ext), render(model));
            Process.Start(new ProcessStartInfo(path) { UseShellExecute = true });
            Snackbar.ReportSaved(path);
        }
        catch (Exception ex) { Fail("Excel/PDF export", ex); }
        finally { busy = false; }
    }

    /// <summary>Certificate_SURNAME_yyyy_MM.ext (Latin characters): the name of every saved certificate.</summary>
    private string FileName(OvertimeCertificateModel model, string ext) =>
        $"Certificate_{GreekText.ToLatin(model.LastName)}_{year}_{month:00}.{ext}";

    /// <summary>
    /// Draws the progress bar before the report work starts: building and rendering a report
    /// keeps the UI thread busy, so without this pause the bar would never be seen.
    /// </summary>
    private async Task ShowBusyAsync()
    {
        StateHasChanged();
        await Task.Delay(1);
    }

    /// <summary>Logs the error (Documents\Vardiologio\Logs) and shows what went wrong on the page.</summary>
    private void Fail(string action, Exception ex)
    {
        ErrorLog.Error($"Overtime certificate / {action}", ex);
        error = ex.Message;
    }
}
