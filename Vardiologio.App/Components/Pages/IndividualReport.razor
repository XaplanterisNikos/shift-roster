@page "/individual"
@using Vardiologio.Application.Reports
@using Vardiologio.Application.ShiftEntry
@inject IIndividualReportService Report
@inject IShiftEntryService ShiftService

@* Individual analytical sheet (preview). Currently shows the computable columns;
   overtime / day-night split / ΣΤΑΣΕΙΣ are intentionally blank until their rules are defined. *@
<h1>Ατομικό φύλλο (Ανάλυση παρουσιών & ωραρίων)</h1>

<div class="filters">
    <label>
        Έτος
        <select @bind="year">
            @for (int y = DateTime.Today.Year - 1; y <= DateTime.Today.Year + 1; y++)
            {
                <option value="@y">@y</option>
            }
        </select>
    </label>
    <label>
        Μήνας
        <select @bind="month">
            @for (int mo = 1; mo <= 12; mo++)
            {
                <option value="@mo">@Months[mo - 1]</option>
            }
        </select>
    </label>
    <label>
        Εργαζόμενος
        <select @bind="employeeId">
            <option value="0">— επίλεξε —</option>
            @foreach (var e in employees)
            {
                <option value="@e.Id">@e.Display</option>
            }
        </select>
    </label>
    <button @onclick="LoadAsync" disabled="@(employeeId == 0)">Προεπισκόπηση</button>
</div>
@* Complex two-row header (rowspan/colspan) mirroring the official sheet layout. *@
@if (model is not null)
{
    <div class="indiv-scroll">
        <table class="indiv">
            <thead>
                <tr>
                    <th rowspan="2">ΗΜΕΡ.</th>
                    <th rowspan="2">Α/Α</th>
                    <th rowspan="2">ΟΝΟΜΑΤΕΠΩΝΥΜΟ</th>
                    <th rowspan="2">ΕΙΔΟΣ<br />ΕΡΓΑΣΙΑΣ</th>
                    <th colspan="2">ΩΡΑΡΙΟ ΒΑΡΔΙΑΣ</th>
                    <th colspan="2">ΩΡΑΡΙΟ ΥΠΕΡΩΡΙΑΣ</th>
                    <th colspan="2">ΣΥΜΠΛΗΡ. ΕΡΓΑΣΙΑ</th>
                    <th rowspan="2">ΩΡΑΡΙΑ</th>
                    <th rowspan="2">ΠΑΡΟΥΣΙΕΣ</th>
                    <th rowspan="2">ΣΤΑΣΕΙΣ</th>
                    <th colspan="3">ΗΜΕΡΗΣΙΟ (Δ–Σ)</th>
                    <th colspan="3">ΝΥΚΤΕΡΙΝΟ (Δ–Σ)</th>
                    <th colspan="2">ΗΜΕΡ. ΚΥΡ.</th>
                    <th colspan="2">ΝΥΚΤ. ΚΥΡ.</th>
                </tr>
                <tr>
                    <th>ΕΝΑΡΞΗ</th>
                    <th>ΛΗΞΗ</th>
                    <th>ΕΝΑΡΞΗ</th>
                    <th>ΛΗΞΗ</th>
                    <th>ΗΜΕΡ.</th>
                    <th>ΚΥΡΙΑΚΗΣ</th>
                    <th>ΩΡ.</th>
                    <th>ΕΝ.</th>
                    <th>ΛΗ.</th>
                    <th>ΩΡ.</th>
                    <th>ΕΝ.</th>
                    <th>ΛΗ.</th>
                    <th>ΕΝ.</th>
                    <th>ΛΗ.</th>
                    <th>ΕΝ.</th>
                    <th>ΛΗ.</th>
                </tr>
            </thead>
            @* Status day -> show the code; working day -> show shift start/end. *@
            <tbody>
                @foreach (var r in model.Days)
                {
                    <tr class="@(r.IsSunday ? "sun" : "")">
                        <td>@r.Date.ToString("dd/MM")</td>
                        <td>@r.Index</td>
                        <td class="lft">@model.EmployeeName</td>
                        <td>@model.WorkType</td>
                        <td>@(r.StatusCode ?? r.ShiftStart)</td>
                        <td>@(r.StatusCode is null ? r.ShiftEnd : "")</td>
                        <td></td>
                        <td></td>                                   @* ΥΠΕΡΩΡΙΑ — κενό *@
                        <td>@Fmt(r.SupplementWeekday)</td>
                        <td>@Fmt(r.SupplementSunday)</td>
                        <td></td>                                            @* ΩΡΑΡΙΑ — κενό *@
                        <td>@r.Presence</td>
                        <td></td>                                            @* ΣΤΑΣΕΙΣ — κενό *@
                        <td></td>
                        <td></td>
                        <td></td>                          @* ΗΜΕΡΗΣΙΟ Δ–Σ — κενό *@
                        <td></td>
                        <td></td>
                        <td></td>                          @* ΝΥΚΤΕΡΙΝΟ Δ–Σ — κενό *@
                        <td></td>
                        <td></td>                                   @* ΗΜΕΡ. ΚΥΡ. — κενό *@
                        <td></td>
                        <td></td>                                   @* ΝΥΚΤ. ΚΥΡ. — κενό *@
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <table class="indiv totals">
        <tr>
            <th colspan="3">Εργασία προς Συμπλήρωση (ΕΒΔΟΜΑΔΙΑΙΑ)</th>
            <th colspan="3">Εργασία προς Συμπλήρωση (ΚΥΡΙΑΚΩΝ–ΕΞΑΙΡΕΣΙΜΩΝ)</th>
        </tr>
        <tr><th>Α'</th><th>Β'</th><th>ΣΥΝΟΛΟ ΜΗΝΟΣ</th><th>Α'</th><th>Β'</th><th>ΣΥΝΟΛΟ ΜΗΝΟΣ</th></tr>
        <tr>
            <td>@Fmt(model.WeekdayFirstHalf)</td>
            <td>@Fmt(model.WeekdaySecondHalf)</td>
            <td><b>@Fmt(model.WeekdayTotal)</b></td>
            <td>@Fmt(model.SundayFirstHalf)</td>
            <td>@Fmt(model.SundaySecondHalf)</td>
            <td><b>@Fmt(model.SundayTotal)</b></td>
        </tr>
    </table>
}

@code {
    private IReadOnlyList<EmployeeListItem> employees = Array.Empty<EmployeeListItem>();
    private int year = DateTime.Today.Year;
    private int month = DateTime.Today.Month;
    private int employeeId;
    private IndividualReportModel? model;

    protected override async Task OnInitializedAsync()
        => employees = await ShiftService.GetEmployeesAsync();

    private async Task LoadAsync()
        => model = await Report.BuildAsync(employeeId, year, month);// build the individual sheet

    /// <summary>Formats an optional hours value; blank when null or zero.</summary>
    private static string Fmt(decimal? v) => v is null or 0 ? "" : v.Value.ToString("0.##");

    private static readonly string[] Months =
        { "Ιανουάριος","Φεβρουάριος","Μάρτιος","Απρίλιος","Μάιος","Ιούνιος",
          "Ιούλιος","Αύγουστος","Σεπτέμβριος","Οκτώβριος","Νοέμβριος","Δεκέμβριος" };
}