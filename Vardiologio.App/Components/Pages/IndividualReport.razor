@page "/individual"
@using System.Diagnostics
@using Vardiologio.Application.Files
@using Vardiologio.Application.Logging
@using Vardiologio.Application.ReportColors
@using Vardiologio.Application.Reports
@using Vardiologio.Application.ShiftEntry
@inject IIndividualReportService Report
@inject IShiftEntryService ShiftService
@inject IExcelReportRenderer Excel
@inject IPdfReportRenderer Pdf
@inject IReportFileStore FileStore
@inject IErrorLog ErrorLog

@* Individual analytical sheet of one employee for one month: on-screen preview, Excel and PDF.
   Columns, cell values and the summary come from IndividualSheetLayout (Application), so the
   three outputs always agree. Styles: "table.indiv" rules in app.css. *@
<h1>Ατομικό φύλλο (Ανάλυση παρουσιών & ωραρίων)</h1>

<div class="filters">
    <label>
        Έτος
        <select @bind="year">
            @for (int y = DateTime.Today.Year - 1; y <= DateTime.Today.Year + 1; y++)
            {
                <option value="@y">@y</option>
            }
        </select>
    </label>
    <label>
        Μήνας
        <select @bind="month">
            @for (int mo = 1; mo <= 12; mo++)
            {
                <option value="@mo">@Months[mo - 1]</option>
            }
        </select>
    </label>
    @* Search box instead of a plain list: type part of the surname or first name (Shared/EmployeePicker.razor). *@
    <div class="filter-employee-box">
        <EmployeePicker Employees="employees" @bind-Value="employeeId" />
    </div>
    <button @onclick="PreviewAsync" disabled="@(busy || employeeId == 0)">Προεπισκόπηση</button>
    <button @onclick="ExportExcelAsync" disabled="@(busy || employeeId == 0)">Εξαγωγή Excel</button>
    <button @onclick="ExportPdfAsync" disabled="@(busy || employeeId == 0)">Εξαγωγή PDF</button>
</div>

@if (message is not null)
{
    <p class="ok">@message</p>
}
@if (error is not null)
{
    <p style="color:#c00">@error</p>
}

@if (model is not null)
{
    <p class="indiv-sub">@IndividualSheetLayout.Subtitle(model)</p>
    @if (model.WorkType.Length == 0)
    {
        @* The column is filled from the employee's contract; say why it is empty instead of leaving a silent gap. *@
        <p class="hint">Το «Είδος εργασίας» είναι κενό επειδή ο εργαζόμενος δεν έχει σύμβαση. Ορίστε τη στο μενού «Εργαζόμενοι», στο πεδίο «Σύμβαση».</p>
    }

    @* Two-row header: a header without sub-columns spans both rows, a group spans its sub-columns. *@
    <div class="indiv-scroll">
        @* --sun-bg: the Sunday colour of Παράμετροι → Αναφορών → Χρώματα (read by "tr.sun" in app.css). *@
        <table class="indiv sheet" style="--sun-bg:@(model.Colors[ReportColorCatalog.IndividualSunday])">
            <thead>
                <tr>
                    @foreach (var header in IndividualSheetLayout.Headers)
                    {
                        @if (header.Subs.Length == 0)
                        {
                            <th rowspan="2">@header.Text</th>
                        }
                        else
                        {
                            <th colspan="@header.Span">@header.Text</th>
                        }
                    }
                </tr>
                <tr>
                    @foreach (var header in IndividualSheetLayout.Headers)
                    {
                        @foreach (var sub in header.Subs)
                        {
                            <th>@sub</th>
                        }
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var r in model.Days)
                {
                    var cells = IndividualSheetLayout.Cells(model, r);
                    <tr class="@(r.IsSunday ? "sun" : "")">
                        @for (int i = 0; i < cells.Length; i++)
                        {
                            @* The name column is the only left-aligned one. *@
                            <td class="@(i == IndividualSheetLayout.NameColumn ? "lft" : "")">@cells[i]</td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @* Summary of the month: one box per group of numbers, each saying where its numbers come from. *@
    <div class="indiv-summary">
        @foreach (var block in IndividualSheetLayout.Summary(model))
        {
            <div class="indiv-block">
                <div class="indiv-block-title">@block.Title</div>
                <div class="indiv-block-note">@block.Note</div>
                <table class="indiv totals">
                    <tr>
                        @foreach (var cell in block.Cells)
                        {
                            <th>@cell.Header</th>
                        }
                    </tr>
                    <tr>
                        @foreach (var cell in block.Cells)
                        {
                            <td><b>@cell.Value</b></td>
                        }
                    </tr>
                </table>
            </div>
        }
    </div>
}

@code {
    private IReadOnlyList<EmployeeListItem> employees = Array.Empty<EmployeeListItem>();
    private int year = DateTime.Today.Year;
    private int month = DateTime.Today.Month;
    private int employeeId;
    private bool busy;
    private string? message, error;
    private IndividualReportModel? model;

    /// <summary>Loads the active employees for the picker.</summary>
    protected override async Task OnInitializedAsync()
        => employees = await ShiftService.GetEmployeesAsync();

    /// <summary>Builds the sheet and shows it on the page (no file written).</summary>
    private async Task PreviewAsync()
    {
        busy = true; message = null; error = null;
        try
        {
            model = await Report.BuildAsync(employeeId, year, month);
        }
        catch (Exception ex) { Fail("Preview", ex); }
        finally { busy = false; }
    }

    private Task ExportExcelAsync() => ExportAsync(m => Excel.Render(m), "xlsx");
    private Task ExportPdfAsync() => ExportAsync(m => Pdf.Render(m), "pdf");

    /// <summary>
    /// Builds the sheet, writes Individual_SURNAME_yyyy_MM (Latin characters) under
    /// Reports\Individual-Sheet\&lt;month&gt; and opens it with the default application.
    /// The preview is refreshed too, so the page shows what was exported.
    /// </summary>
    private async Task ExportAsync(Func<IndividualReportModel, byte[]> render, string ext)
    {
        busy = true; message = null; error = null;
        try
        {
            model = await Report.BuildAsync(employeeId, year, month);
            var fileName = $"Individual_{GreekText.ToLatin(model.LastName)}_{year}_{month:00}.{ext}";
            var path = await FileStore.SaveAsync(ReportFolder.IndividualSheet, year, month, fileName, render(model));
            Process.Start(new ProcessStartInfo(path) { UseShellExecute = true });
            message = $"Δημιουργήθηκε: {path}";
        }
        catch (Exception ex) { Fail("Excel/PDF export", ex); }
        finally { busy = false; }
    }

    /// <summary>Logs the error (Documents\Vardiologio\Logs) and shows its message on the page.</summary>
    private void Fail(string action, Exception ex)
    {
        ErrorLog.Error($"Individual sheet / {action}", ex);
        error = ex.Message;
    }

    private static readonly string[] Months =
        { "Ιανουάριος","Φεβρουάριος","Μάρτιος","Απρίλιος","Μάιος","Ιούνιος",
          "Ιούλιος","Αύγουστος","Σεπτέμβριος","Οκτώβριος","Νοέμβριος","Δεκέμβριος" };
}
