@page "/individual"
@using System.Diagnostics
@using System.Globalization
@using Vardiologio.Application.Parameters
@using Vardiologio.Application.Files
@using Vardiologio.Application.Logging
@using Vardiologio.Application.Printing
@using Vardiologio.Application.ReportColors
@using Vardiologio.Application.Reports
@using Vardiologio.Application.ShiftEntry
@inject IIndividualReportService Report
@inject IShiftEntryService ShiftService
@inject ISignatoryService SignatoryService
@inject IExcelReportRenderer Excel
@inject IPdfReportRenderer Pdf
@inject IReportFileStore FileStore
@inject IPdfPrinter Printer
@inject IErrorLog ErrorLog
@inject ISnackbar Snackbar

@* Individual analytical sheet of one employee for one month: on-screen preview, Excel and PDF.
   Columns, cell values and the summary come from IndividualSheetLayout (Application), so the
   three outputs always agree. "Εκτυπώσεις" opens the batch list (BatchPrintPanel) with two
   columns of this page: who signs and the date, per employee (his own supervisor and the date
   of the page to start with). The ticked employees are printed one after the other on the
   printer chosen once, each previewed and saved as its PDF first, with "3 από 20" on the button.
   Styles: "table.indiv" rules and "Batch printing" block in app.css. *@
<div class="page-head">
    <div>
        <MudText Typo="Typo.h4">Ατομικό φύλλο (Ανάλυση παρουσιών & ωραρίων)</MudText>
        <MudText Typo="Typo.body2" Class="page-sub">Οι ημέρες, τα ωράρια και οι ώρες ενός εργαζομένου για τον μήνα.</MudText>
    </div>
</div>

<ReportToolbar @bind-Year="year" @bind-Month="month" Busy="busy" Disabled="@(employeeId == 0)"
               OnPreview="PreviewAsync" OnExcel="ExportExcelAsync" OnPdf="ExportPdfAsync"
               OnBatch="ToggleBatchAsync" BatchText="@batchText">
    <EmployeePicker Employees="employees" @bind-Value="employeeId" @bind-Value:after="OnEmployeeChangedAsync" Class="report-employee" />

    <MudSelect T="int?" Label="Υπογράφει (εξαγωγή)" @bind-Value="signatoryId"
               Variant="Variant.Outlined" Margin="Margin.Dense" Class="report-signer"
               Disabled="@(employeeId == 0 || busy)" ToStringFunc="SignatoryText">
        <MudSelectItem T="int?" Value="@((int?)null)">— χωρίς υπογράφοντα —</MudSelectItem>
        @foreach (var s in signatories.Where(x => x.IsActive || x.Id == signatoryId))
        {
            <MudSelectItem T="int?" Value="@((int?)s.Id)">@SignatoryItem.Label(s.FullName, s.Role)</MudSelectItem>
        }
    </MudSelect>
    <MudDatePicker Label="Ημερομηνία (εξαγωγή)" @bind-Date="issueDate" Culture="El" DateFormat="dd/MM/yyyy"
                   Placeholder="1η επόμενου μήνα" Clearable="true" AutoClose="true"
                   Variant="Variant.Outlined" Margin="Margin.Dense" Class="report-date"
                   Disabled="@(employeeId == 0 || busy)" />
</ReportToolbar>

@if (batchOpen)
{
    <BatchPrintPanel Employees="employees" Subtitle="@BatchMonth" OnPrint="PrintBatchAsync" OnClose="ToggleBatchAsync">
        <ExtraHeaders>
            <th>Υπογράφει</th>
            <th>Ημερομηνία</th>
        </ExtraHeaders>
        <ExtraCells Context="e">
            <td class="batch-signer">
                <MudSelect T="int?" Value="@batchSigners.GetValueOrDefault(e.Id)" ValueChanged="v => batchSigners[e.Id] = v"
                           Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" ToStringFunc="SignatoryText">
                    <MudSelectItem T="int?" Value="@((int?)null)">— χωρίς υπογράφοντα —</MudSelectItem>
                    @foreach (var s in signatories.Where(x => x.IsActive || x.Id == batchSigners.GetValueOrDefault(e.Id)))
                    {
                        <MudSelectItem T="int?" Value="@((int?)s.Id)">@SignatoryItem.Label(s.FullName, s.Role)</MudSelectItem>
                    }
                </MudSelect>
            </td>
            <td class="batch-date">
                <MudDatePicker Date="@batchDates.GetValueOrDefault(e.Id)" DateChanged="d => batchDates[e.Id] = d"
                               Culture="El" DateFormat="dd/MM/yyyy" Placeholder="1η επόμενου μήνα"
                               Clearable="true" AutoClose="true" Variant="Variant.Outlined" Margin="Margin.Dense" />
            </td>
        </ExtraCells>
    </BatchPrintPanel>
}

@if (error is not null)
{
    <MudAlert Severity="Severity.Error" Dense="true" Class="report-alert">@error</MudAlert>
}

@if (model is null && error is null && !busy && !batchOpen)
{
    <MudPaper Elevation="0" Class="empty-state">
        <MudIcon Icon="@Icons.Material.Rounded.PersonSearch" Size="Size.Large" />
        <MudText Typo="Typo.body1">Επιλέξτε μήνα και εργαζόμενο και πατήστε «Προεπισκόπηση».</MudText>
    </MudPaper>
}

@if (model is not null)
{
    <p class="indiv-sub">@IndividualSheetLayout.Subtitle(model)</p>
    @if (model.WorkType.Length == 0)
    {
        <MudAlert Severity="Severity.Info" Dense="true" Class="report-alert">
            Το «Είδος εργασίας» είναι κενό επειδή ο εργαζόμενος δεν έχει σύμβαση. Ορίστε τη στο μενού «Εργαζόμενοι», στο πεδίο «Σύμβαση».
        </MudAlert>
    }

    <div class="indiv-scroll">
        <table class="indiv sheet" style="--sun-bg:@(model.Colors[ReportColorCatalog.IndividualSunday])">
            <thead>
                <tr>
                    @foreach (var header in IndividualSheetLayout.Headers)
                    {
                        @if (header.Subs.Length == 0)
                        {
                            <th rowspan="2">@header.Text</th>
                        }
                        else
                        {
                            <th colspan="@header.Span">@header.Text</th>
                        }
                    }
                </tr>
                <tr>
                    @foreach (var header in IndividualSheetLayout.Headers)
                    {
                        @foreach (var sub in header.Subs)
                        {
                            <th>@sub</th>
                        }
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var r in model.Days)
                {
                    var cells = IndividualSheetLayout.Cells(model, r);
                    <tr class="@(r.IsSunday ? "sun" : "")">
                        @for (int i = 0; i < cells.Length; i++)
                        {
                            <td class="@(i == IndividualSheetLayout.NameColumn ? "lft" : "")">@cells[i]</td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="indiv-summary">
        @foreach (var block in IndividualSheetLayout.Summary(model))
        {
            <div class="indiv-block">
                <div class="indiv-block-title">@block.Title</div>
                <div class="indiv-block-note">@block.Note</div>
                <table class="indiv totals">
                    <tr>
                        @foreach (var cell in block.Cells)
                        {
                            <th>@cell.Header</th>
                        }
                    </tr>
                    <tr>
                        @foreach (var cell in block.Cells)
                        {
                            <td><b>@cell.Value</b></td>
                        }
                    </tr>
                </table>
            </div>
        }
    </div>
}

@code {
    private IReadOnlyList<EmployeeListItem> employees = Array.Empty<EmployeeListItem>();
    private int year = DateTime.Today.Year;
    private int month = DateTime.Today.Month;
    private int employeeId;
    private bool busy;
    private string? error;
    private IndividualReportModel? model;

    /// <summary>All supervisors (inactive ones too, so an employee's retired one still shows).</summary>
    private IReadOnlyList<SignatoryItem> signatories = Array.Empty<SignatoryItem>();

    /// <summary>Who signs on the right of the exported sheet (null = nobody).</summary>
    private int? signatoryId;

    /// <summary>Date printed top right of the exported sheet; null = the 1st of the next month.</summary>
    private DateTime? issueDate;

    private static readonly CultureInfo El = CultureInfo.GetCultureInfo("el-GR");

    /// <summary>The batch list is open under the toolbar.</summary>
    private bool batchOpen;

    /// <summary>Text of the batch button while a batch runs ("3 από 20"); null otherwise.</summary>
    private string? batchText;

    /// <summary>Last PDF saved by the batch: its folder opens from the closing message.</summary>
    private string? batchSaved;

    /// <summary>Who signs each employee's sheet in the batch (employee id → supervisor id or null).</summary>
    private Dictionary<int, int?> batchSigners = new();

    /// <summary>Date of each employee's sheet in the batch (null = the 1st of the next month).</summary>
    private Dictionary<int, DateTime?> batchDates = new();

    /// <summary>Loads the active employees for the picker and the supervisors for the export.</summary>
    protected override async Task OnInitializedAsync()
    {
        employees = await ShiftService.GetEmployeesAsync();
        signatories = await SignatoryService.GetAllAsync(includeInactive: true);
    }

    /// <summary>A new employee was picked: the export's supervisor becomes his own.</summary>
    private async Task OnEmployeeChangedAsync()
    {
        signatoryId = employeeId == 0 ? null : await SignatoryService.GetEmployeeSignatoryIdAsync(employeeId);
    }

    /// <summary>Text of the closed supervisor box.</summary>
    private string SignatoryText(int? id) =>
        signatories.FirstOrDefault(x => x.Id == id) is { } s ? SignatoryItem.Label(s.FullName, s.Role) : "— χωρίς υπογράφοντα —";

    /// <summary>
    /// Puts the export choices on the model: the supervisor (or none) and the date, when one was
    /// set. Used only for the Excel / PDF, not for the preview.
    /// </summary>
    /// <param name="m">The built sheet.</param>
    /// <param name="signer">Id of the supervisor who signs; null = nobody.</param>
    /// <param name="date">Date printed top right; null = the 1st of the next month.</param>
    private void ApplyExportChoices(IndividualReportModel m, int? signer, DateTime? date)
    {
        m.Supervisor = signatories.FirstOrDefault(x => x.Id == signer) is { } s
            ? new IndividualSigner(s.RoleLines, s.FullName, s.Title ?? "")
            : null;
        if (date is { } d) m.IssueDate = DateOnly.FromDateTime(d);
    }

    /// <summary>
    /// Opens the batch list (nothing ticked; each employee with his own supervisor and the date
    /// of the page) or closes it.
    /// </summary>
    private async Task ToggleBatchAsync()
    {
        if (batchOpen)
        {
            batchOpen = false;
            return;
        }

        try
        {
            var own = (await SignatoryService.GetEmployeesAsync()).ToDictionary(x => x.Id, x => x.SignatoryId);
            batchSigners = employees.ToDictionary(e => e.Id, e => own.GetValueOrDefault(e.Id));
            batchDates = employees.ToDictionary(e => e.Id, _ => issueDate);
            batchOpen = true;
        }
        catch (Exception ex) { Fail("Batch list", ex); }
    }

    /// <summary>Month of the batch, for the list's subtitle.</summary>
    private string BatchMonth => new DateTime(year, month, 1).ToString("MMMM yyyy", El);

    /// <summary>
    /// Prints the ticked employees: the printer is chosen once (cancel = nothing happens, the list
    /// stays open), the list closes, and each sheet is previewed, saved as PDF and printed before
    /// the next one. Failures are logged and listed at the end; the batch goes on.
    /// </summary>
    private async Task PrintBatchAsync(IReadOnlyList<EmployeeListItem> chosen)
    {
        if (Printer.ChoosePrinter() is not { } target) return;

        batchOpen = false; busy = true; error = null; batchSaved = null;
        var result = await BatchPrint.RunAsync(chosen, e => e.Display, ShowBatchProgressAsync,
            MakeBatchPdfAsync, target,
            (e, ex) => ErrorLog.Error($"Individual sheet / Batch print {e.Display}", ex));
        busy = false; batchText = null;
        Snackbar.BatchPrinted(result, chosen.Count, batchSaved);
    }

    /// <summary>Shows "n από total" on the batch button and lets the page draw it.</summary>
    private async Task ShowBatchProgressAsync(int number, int total)
    {
        batchText = $"{number} από {total}";
        await ShowBusyAsync();
    }

    /// <summary>
    /// One sheet of the batch: built and shown on the page, given the supervisor and date of its
    /// row, saved like the PDF export (without opening it), and returned for the printer.
    /// </summary>
    private async Task<byte[]> MakeBatchPdfAsync(EmployeeListItem employee)
    {
        model = await Report.BuildAsync(employee.Id, year, month);
        await ShowBusyAsync();
        ApplyExportChoices(model, batchSigners.GetValueOrDefault(employee.Id), batchDates.GetValueOrDefault(employee.Id));
        var pdf = Pdf.Render(model);
        batchSaved = await FileStore.SaveAsync(ReportFolder.IndividualSheet, year, month, FileName(model, "pdf"), pdf);
        return pdf;
    }

    /// <summary>Builds the sheet and shows it on the page (no file written).</summary>
    private async Task PreviewAsync()
    {
        busy = true; error = null;
        await ShowBusyAsync();
        try
        {
            model = await Report.BuildAsync(employeeId, year, month);
        }
        catch (Exception ex) { Fail("Preview", ex); }
        finally { busy = false; }
    }

    private Task ExportExcelAsync() => ExportAsync(m => Excel.Render(m), "xlsx");
    private Task ExportPdfAsync() => ExportAsync(m => Pdf.Render(m), "pdf");

    /// <summary>
    /// Builds the sheet, writes Individual_SURNAME_yyyy_MM (Latin characters) under
    /// Reports\Individual-Sheet\&lt;month&gt; and opens it with the default application.
    /// The preview is refreshed too, so the page shows what was exported.
    /// </summary>
    private async Task ExportAsync(Func<IndividualReportModel, byte[]> render, string ext)
    {
        busy = true; error = null;
        await ShowBusyAsync();
        try
        {
            model = await Report.BuildAsync(employeeId, year, month);
            ApplyExportChoices(model, signatoryId, issueDate);
            var path = await FileStore.SaveAsync(ReportFolder.IndividualSheet, year, month, FileName(model, ext), render(model));
            Process.Start(new ProcessStartInfo(path) { UseShellExecute = true });
            Snackbar.ReportSaved(path);
        }
        catch (Exception ex) { Fail("Excel/PDF export", ex); }
        finally { busy = false; }
    }

    /// <summary>Individual_SURNAME_yyyy_MM.ext (Latin characters): the name of every saved sheet.</summary>
    private string FileName(IndividualReportModel m, string ext) =>
        $"Individual_{GreekText.ToLatin(m.LastName)}_{year}_{month:00}.{ext}";

    /// <summary>
    /// Draws the progress bar before the report work starts: building and rendering a report
    /// keeps the UI thread busy, so without this pause the bar would never be seen.
    /// </summary>
    private async Task ShowBusyAsync()
    {
        StateHasChanged();
        await Task.Delay(1);
    }

    /// <summary>Logs the error (Documents\Vardiologio\Logs) and shows what went wrong on the page.</summary>
    private void Fail(string action, Exception ex)
    {
        ErrorLog.Error($"Individual sheet / {action}", ex);
        error = ex.Message;
    }
}
