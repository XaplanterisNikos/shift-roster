@page "/contract-certificate"
@using System.Diagnostics
@using System.IO
@using Vardiologio.Application.Files
@using Vardiologio.Application.Logging
@using Vardiologio.Application.Reports
@inject IContractCertificateService ContractCertificateService
@inject IExcelReportRenderer Excel
@inject IPdfReportRenderer Pdf
@inject IReportFileStore FileStore
@inject IErrorLog ErrorLog
@inject ISnackbar Snackbar

@* Collective "ΠΙΣΤΟΠΟΙΗΣΗ ΥΠΕΡΩΡΙΑΚΗΣ ΚΑΙ ΛΟΙΠΗΣ ΕΡΓΑΣΙΑΣ" per contract, in one form: permanent
   staff, then open-ended contracts (ΙΔΑΧ), then fixed-term contracts (ΙΔΟΧ), one under the other.
   The preview is the PDF itself (exactly what gets printed); an export writes the same form
   (Excel or PDF). *@
<div class="page-head">
    <div>
        <MudText Typo="Typo.h4">Εξαγωγή Πιστοποίησης ανά Σύμβαση (ΙΔΟΧ / ΙΔΑΧ / Μόνιμοι)</MudText>
        <MudText Typo="Typo.body2" Class="page-sub">Ένα έντυπο: Μόνιμοι, μετά ΙΔΑΧ και μετά ΙΔΟΧ, ο ένας κάτω από τον άλλο.</MudText>
    </div>
</div>

<ReportToolbar @bind-Year="year" @bind-Month="month" Busy="busy"
               OnPreview="PreviewAsync" OnExcel="ExportExcelAsync" OnPdf="ExportPdfAsync" />

@if (error is not null)
{
    <MudAlert Severity="Severity.Error" Dense="true" Class="report-alert">@error</MudAlert>
}
@if (withoutContract.Count > 0)
{
    <MudAlert Severity="Severity.Warning" Dense="true" Class="report-alert">
        Δεν περιλαμβάνονται στο έντυπο, επειδή δεν έχουν σύμβαση Μόνιμου, ΙΔΑΧ ή ΙΔΟΧ
        (Εργαζόμενοι → Σύμβαση): @(string.Join(", ", withoutContract)).
    </MudAlert>
}

@if (pdfDataUri is not null)
{
    <MudText Typo="Typo.h6" Class="mb-2">Μόνιμοι / ΙΔΑΧ / ΙΔΟΧ</MudText>
    <PdfPreview Data="@pdfDataUri" />
}

@code {
    private int year = DateTime.Today.Year;
    private int month = DateTime.Today.Month;
    private bool busy;
    private string? error;

    /// <summary>PDF data-URI of the form, after "Προεπισκόπηση".</summary>
    private string? pdfDataUri;

    /// <summary>Employees left out of the form (no contract of the three kinds); shown as a note.</summary>
    private List<string> withoutContract = new();

    /// <summary>
    /// The page opens with the current month already shown. Done after the first render, so
    /// the page appears at once and the report follows; for another month the user picks it
    /// and presses the button.
    /// </summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        await PreviewAsync();
        StateHasChanged();
    }

    /// <summary>Renders the form to PDF in memory and shows it inline (no file written).</summary>
    private async Task PreviewAsync()
    {
        busy = true; error = null; pdfDataUri = null;
        await ShowBusyAsync();
        try
        {
            var model = await ContractCertificateService.BuildAsync(year, month);
            withoutContract = model.WithoutContract;
            pdfDataUri = "data:application/pdf;base64," + Convert.ToBase64String(Pdf.Render(model));
        }
        catch (Exception ex) { Fail("Preview", ex); }
        finally { busy = false; }
    }

    private Task ExportExcelAsync() => ExportAsync(m => Excel.Render(m), "xlsx");
    private Task ExportPdfAsync() => ExportAsync(m => Pdf.Render(m), "pdf");

    /// <summary>Writes the file of the form, then opens it with the default application.</summary>
    private async Task ExportAsync(Func<ContractCertificateModel, byte[]> render, string ext)
    {
        busy = true; error = null;
        await ShowBusyAsync();
        try
        {
            var model = await ContractCertificateService.BuildAsync(year, month);
            withoutContract = model.WithoutContract;
            var path = await FileStore.SaveAsync(ReportFolder.ContractCertificate, year, month, FileName(ext), render(model));
            Open(path);
            Snackbar.ReportSaved(path);
        }
        catch (Exception ex) { Fail("Excel/PDF export", ex); }
        finally { busy = false; }
    }

    /// <summary>Certificate_Contracts_yyyy_MM (Latin characters only).</summary>
    private string FileName(string ext) => $"Certificate_Contracts_{year}_{month:00}.{ext}";

    /// <summary>Opens a file with its default application.</summary>
    private static void Open(string path) => Process.Start(new ProcessStartInfo(path) { UseShellExecute = true });

    /// <summary>
    /// Draws the progress bar before the report work starts: building and rendering a report
    /// keeps the UI thread busy, so without this pause the bar would never be seen.
    /// </summary>
    private async Task ShowBusyAsync()
    {
        StateHasChanged();
        await Task.Delay(1);
    }

    /// <summary>Logs the error (Documents\Vardiologio\Logs) and shows what went wrong on the page.</summary>
    private void Fail(string action, Exception ex)
    {
        ErrorLog.Error($"Contract certificate / {action}", ex);
        error = ex.Message;
    }
}
