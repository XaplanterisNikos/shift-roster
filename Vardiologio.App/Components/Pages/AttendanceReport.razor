@page "/attendance-report"
@using System.Diagnostics
@using System.IO
@using Vardiologio.Application.Files
@using Vardiologio.Application.Logging
@using Vardiologio.Application.Reports
@inject IAttendanceReportService AttendanceReportService
@inject IExcelReportRenderer Excel
@inject IPdfReportRenderer Pdf
@inject IReportFileStore FileStore
@inject IErrorLog ErrorLog
@inject ISnackbar Snackbar

@* Monthly staff attendance report ("ΠΙΝΑΚΑΣ ΠΑΡΟΥΣΙΩΝ ΠΡΟΣΩΠΙΚΟΥ"), in three reports:
   permanent and open-ended staff, fixed-term staff, and the directorate. The preview is the
   PDF itself (exactly what gets printed); every export writes one file per report (Excel or PDF). *@
<div class="page-head">
    <div>
        <MudText Typo="Typo.h4">Εξαγωγή Αναφοράς Παρουσιών Προσωπικού</MudText>
        <MudText Typo="Typo.body2" Class="page-sub">Τρία έντυπα: ΙΔΑΧ / Μόνιμοι, ΙΔΟΧ και Διεύθυνση. Κάθε εξαγωγή γράφει ένα αρχείο για το καθένα.</MudText>
    </div>
</div>

@* Month, preview and export buttons (Shared/ReportToolbar.razor). *@
<ReportToolbar @bind-Year="year" @bind-Month="month" Busy="busy"
               OnPreview="PreviewAsync" OnExcel="ExportExcelAsync" OnPdf="ExportPdfAsync" />

@if (error is not null)
{
    <MudAlert Severity="Severity.Error" Dense="true" Class="report-alert">@error</MudAlert>
}
@if (noDirector)
{
    <MudAlert Severity="Severity.Warning" Dense="true" Class="report-alert">
        Δεν βρέθηκε ο Διευθυντής (ενεργός εργαζόμενος με θέση «@PresenceRules.DirectorPosition»)·
        η αναφορά της Διεύθυνσης βγαίνει κενή.
    </MudAlert>
}

@if (withoutContract.Count > 0)
{
    <MudAlert Severity="Severity.Warning" Dense="true" Class="report-alert">
        Χωρίς αναγνωρίσιμη σύμβαση (Μόνιμος, ΙΔΑΧ ή ΙΔΟΧ): @string.Join(", ", withoutContract).
        Τυπώνονται στο έντυπο «ΙΔΑΧ / Μόνιμοι»· ορίστε τη σύμβασή τους στο «Λειτουργίες → Εργαζόμενοι».
    </MudAlert>
}

@if (previews is not null)
{
    @* One tab per report; the PDF under the tabs is the one of the open tab. *@
    <MudTabs Elevation="0" SliderColor="Color.Primary" Class="report-tabs report-sheets"
             ActivePanelIndex="Array.IndexOf(Sheets, activeSheet)"
             ActivePanelIndexChanged="index => activeSheet = Sheets[index]">
        @foreach (var sheet in Sheets)
        {
            <MudTabPanel Text="@TabTitle(sheet)" />
        }
    </MudTabs>

    <PdfPreview Data="@(previews[activeSheet])" />
}

@code {
    /// <summary>The three reports, in tab / file order.</summary>
    private static readonly AttendanceSheet[] Sheets =
        { AttendanceSheet.Staff, AttendanceSheet.FixedTerm, AttendanceSheet.Directorate };

    private int year = DateTime.Today.Year;
    private int month = DateTime.Today.Month;
    private bool busy, noDirector;
    private string? error;
    private AttendanceSheet activeSheet = AttendanceSheet.Staff;

    /// <summary>Employees printed on the staff report because their contract is not recognised.</summary>
    private List<string> withoutContract = new();

    /// <summary>PDF data-URI per report, after "Προεπισκόπηση".</summary>
    private Dictionary<AttendanceSheet, string>? previews;

    /// <summary>Builds the three reports for the selected month, in tab order.</summary>
    private async Task<List<AttendanceReportModel>> BuildAllAsync()
    {
        var models = new List<AttendanceReportModel>();
        foreach (var sheet in Sheets)
            models.Add(await AttendanceReportService.BuildAsync(year, month, sheet));

        // Warn when the director was not found at all (the directorate report is then empty).
        noDirector = models.Single(m => m.Sheet == AttendanceSheet.Directorate).Rows.Count == 0;
        withoutContract = models.Single(m => m.Sheet == AttendanceSheet.Staff).WithoutContract;
        return models;
    }

    /// <summary>
    /// The page opens with the current month already shown. Done after the first render, so
    /// the page appears at once and the report follows; for another month the user picks it
    /// and presses the button.
    /// </summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        await PreviewAsync();
        StateHasChanged();
    }

    /// <summary>Renders the three reports to PDF in memory and shows them inline (no file written).</summary>
    private async Task PreviewAsync()
    {
        busy = true; error = null; previews = null;
        await ShowBusyAsync();
        try
        {
            var models = await BuildAllAsync();
            previews = models.ToDictionary(
                m => m.Sheet,
                m => "data:application/pdf;base64," + Convert.ToBase64String(Pdf.Render(m)));
        }
        catch (Exception ex) { Fail("Preview", ex); }
        finally { busy = false; }
    }

    private Task ExportExcelAsync() => ExportAsync(m => Excel.Render(m), "xlsx");
    private Task ExportPdfAsync() => ExportAsync(m => Pdf.Render(m), "pdf");

    /// <summary>
    /// Writes one file per report (each is a form of its own, with its own signatories),
    /// then opens them with the default application.
    /// </summary>
    private async Task ExportAsync(Func<AttendanceReportModel, byte[]> render, string ext)
    {
        busy = true; error = null;
        await ShowBusyAsync();
        try
        {
            var models = await BuildAllAsync();
            var paths = new List<string>();
            foreach (var m in models)
                paths.Add(await FileStore.SaveAsync(ReportFolder.StaffAttendance, year, month, FileName(m.Sheet, ext), render(m)));
            paths.ForEach(Open);
            Snackbar.ReportSaved(paths.ToArray());
        }
        catch (Exception ex) { Fail("Excel/PDF export", ex); }
        finally { busy = false; }
    }

    /// <summary>
    /// Attendance_IDAX-Monimoi_yyyy_MM, Attendance_IDOX_yyyy_MM or Attendance_Directorate_yyyy_MM
    /// (Latin characters only).
    /// </summary>
    private string FileName(AttendanceSheet sheet, string ext)
    {
        var name = sheet switch
        {
            AttendanceSheet.Directorate => "Directorate",
            AttendanceSheet.FixedTerm => "IDOX",
            _ => "IDAX-Monimoi"
        };
        return $"Attendance_{name}_{year}_{month:00}.{ext}";
    }

    /// <summary>Opens a file with its default application.</summary>
    private static void Open(string path) => Process.Start(new ProcessStartInfo(path) { UseShellExecute = true });

    /// <summary>Tab title of a report.</summary>
    private static string TabTitle(AttendanceSheet sheet) => sheet switch
    {
        AttendanceSheet.Directorate => "Διεύθυνση",
        AttendanceSheet.FixedTerm => "ΙΔΟΧ",
        _ => "ΙΔΑΧ / Μόνιμοι"
    };

    /// <summary>
    /// Draws the progress bar before the report work starts: building and rendering a report
    /// keeps the UI thread busy, so without this pause the bar would never be seen.
    /// </summary>
    private async Task ShowBusyAsync()
    {
        StateHasChanged();
        await Task.Delay(1);
    }

    /// <summary>Logs the error (Documents\Vardiologio\Logs) and shows what went wrong on the page.</summary>
    private void Fail(string action, Exception ex)
    {
        ErrorLog.Error($"Attendance report / {action}", ex);
        error = ex.Message;
    }
}
