@page "/employees"
@using Vardiologio.Application.Employees
@using Microsoft.AspNetCore.Components.Forms
@inject IEmployeeService EmployeeService
@inject Vardiologio.Application.ShiftEntry.IShiftEntryService ShiftService
@inject ISnackbar Snackbar
@inject IDialogService Dialogs

@* Employees CRUD (master-detail): pick a specialty (auto-reloads the list),
   select a name to edit, or "Νέος" to add. The search box is a second way in: picking a name
   there shows that employee's specialty with the employee selected. Soft-delete/restore live in the form.
   Styles: "Master-detail" block in app.css. *@

<div class="page-head">
    <div>
        <MudText Typo="Typo.h4">Εργαζόμενοι</MudText>
        <MudText Typo="Typo.body2" Class="page-sub">Επιλέξτε ειδικότητα, ή αναζητήστε με το όνομα, για να δείτε, να προσθέσετε ή να αλλάξετε εργαζόμενους.</MudText>
    </div>

    @* @bind-Value:after => reload the list automatically when the specialty or the
       "show inactive" switch changes (no button needed here). *@
    <div class="page-filters">
        @* Search by name (Shared/EmployeePicker.razor, as on the report pages): active employees
           of every specialty. A pick opens the employee's specialty and form. *@
        <EmployeePicker Employees="searchList" Value="searchId" ValueChanged="OnSearchPickedAsync"
                        Class="filter-search" />

        @* ToStringFunc: the closed box shows the name, not the Id it is bound to. *@
        <MudSelect T="int" Label="Ειδικότητα" @bind-Value="specialityId" @bind-Value:after="OnSpecialityChanged"
                   Variant="Variant.Outlined" Margin="Margin.Dense" Class="filter-speciality"
                   ToStringFunc="SpecialityName">
            <MudSelectItem T="int" Value="0">— επίλεξε —</MudSelectItem>
            @* Inactive specialities only when "show inactive" is on (or already selected). *@
            @foreach (var s in specialities.Where(o => o.IsActive || includeInactive || o.Id == specialityId))
            {
                <MudSelectItem T="int" Value="@s.Id">@OptionLabel(s)</MudSelectItem>
            }
        </MudSelect>

        <MudSwitch T="bool" @bind-Value="includeInactive" @bind-Value:after="ReloadListAsync"
                   Color="Color.Primary" Label="Εμφάνιση ανενεργών" />

        @* No new employees under a retired speciality. *@
        <MudButton Variant="Variant.Filled" Color="Color.Primary" DropShadow="false" Class="filter-load"
                   StartIcon="@Icons.Material.Rounded.PersonAdd"
                   Disabled="@(specialityId == 0 || !IsSpecialityActive(specialityId))" OnClick="NewEmployee">Νέος</MudButton>
    </div>
</div>

@if (specialityId == 0)
{
    <MudPaper Elevation="0" Class="empty-state">
        <MudIcon Icon="@Icons.Material.Rounded.Groups" Size="Size.Large" />
        <MudText Typo="Typo.body1">Επιλέξτε ειδικότητα για να εμφανιστούν οι εργαζόμενοί της, ή γράψτε ένα όνομα στην αναζήτηση.</MudText>
    </MudPaper>
}
else
{
    <div class="md-grid">
        @* LEFT: employee list of the selected specialty. The list marks the row of selectedId. *@
        <MudPaper Elevation="0" Class="md-list">
            <div class="md-list-head">@list.Count @(list.Count == 1 ? "εργαζόμενος" : "εργαζόμενοι")</div>
            @if (list.Count == 0)
            {
                <MudText Typo="Typo.body2" Class="md-list-empty">Κανένας εργαζόμενος σε αυτή την ειδικότητα.</MudText>
            }
            else
            {
                <MudList T="int" SelectedValue="selectedId" SelectedValueChanged="SelectAsync"
                         Color="Color.Primary" Dense="true">
                    @foreach (var e in list)
                    {
                        <MudListItem T="int" Value="@e.Id" Class="@(e.IsActive ? null : "md-inactive")">
                            <span class="md-item">
                                <span>@e.FullName</span>
                                @if (!e.IsActive)
                                {
                                    @* A plain span: the list puts its rows in a paragraph, where a chip (a div) is not valid HTML. *@
                                    <span class="md-tag">ανενεργός</span>
                                }
                            </span>
                        </MudListItem>
                    }
                </MudList>
            }
        </MudPaper>

        @* RIGHT: create/edit form *@
        @if (form is null)
        {
            <MudPaper Elevation="0" Class="empty-state md-hint">
                <MudIcon Icon="@Icons.Material.Rounded.TouchApp" Size="Size.Large" />
                <MudText Typo="Typo.body1">Επιλέξτε εργαζόμενο από τη λίστα ή πατήστε «Νέος».</MudText>
            </MudPaper>
        }
        else
        {
            <MudPaper Elevation="0" Class="md-form">
                <EditForm Model="form" OnValidSubmit="SaveAsync">
                    <DataAnnotationsValidator />

                    <div class="md-form-head">
                        <MudText Typo="Typo.h6">@(form.Id == 0 ? "Νέος εργαζόμενος" : "Επεξεργασία")</MudText>
                        @if (!form.IsActive)
                        {
                            <span class="md-tag">ανενεργός</span>
                        }
                    </div>

                    @* For: the field shows the message of the DTO's validation attributes under it. *@
                    <div class="md-fields">
                        <MudTextField T="string" Label="Επώνυμο" @bind-Value="form.LastName" For="@(() => form.LastName)"
                                      Variant="Variant.Outlined" Margin="Margin.Dense" />

                        <MudTextField T="string" Label="Όνομα" @bind-Value="form.FirstName" For="@(() => form.FirstName)"
                                      Variant="Variant.Outlined" Margin="Margin.Dense" />

                        <MudSelect T="int" Label="Ειδικότητα" @bind-Value="form.SpecialityId" For="@(() => form.SpecialityId)"
                                   Variant="Variant.Outlined" Margin="Margin.Dense"
                                   ToStringFunc="@(id => NameOf(lookups!.Specialities, id))">
                            <MudSelectItem T="int" Value="0">— επίλεξε —</MudSelectItem>
                            @foreach (var s in Visible(lookups!.Specialities, form.SpecialityId))
                            {
                                <MudSelectItem T="int" Value="@s.Id">@OptionLabel(s)</MudSelectItem>
                            }
                        </MudSelect>

                        <MudSelect T="int?" Label="Σύμβαση" @bind-Value="form.EmploymentTypeId" For="@(() => form.EmploymentTypeId)"
                                   Variant="Variant.Outlined" Margin="Margin.Dense"
                                   ToStringFunc="@(id => NameOf(lookups!.EmploymentTypes, id))">
                            <MudSelectItem T="int?" Value="@((int?)null)">—</MudSelectItem>
                            @foreach (var t in Visible(lookups!.EmploymentTypes, form.EmploymentTypeId))
                            {
                                <MudSelectItem T="int?" Value="@t.Id">@OptionLabel(t)</MudSelectItem>
                            }
                        </MudSelect>

                        <MudSelect T="int?" Label="Θέση" @bind-Value="form.WorkPositionId" For="@(() => form.WorkPositionId)"
                                   Variant="Variant.Outlined" Margin="Margin.Dense"
                                   ToStringFunc="@(id => NameOf(lookups!.WorkPositions, id))">
                            <MudSelectItem T="int?" Value="@((int?)null)">—</MudSelectItem>
                            @foreach (var p in Visible(lookups!.WorkPositions, form.WorkPositionId))
                            {
                                <MudSelectItem T="int?" Value="@p.Id">@OptionLabel(p)</MudSelectItem>
                            }
                        </MudSelect>
                    </div>

                    <div class="md-actions">
                        <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" DropShadow="false"
                                   StartIcon="@Icons.Material.Rounded.Save">Αποθήκευση</MudButton>

                        @if (form.Id != 0)
                        {
                            @if (form.IsActive)
                            {
                                <MudButton Variant="Variant.Outlined" Color="Color.Error" DropShadow="false"
                                           StartIcon="@Icons.Material.Rounded.Delete" OnClick="DeleteAsync">Διαγραφή</MudButton>
                            }
                            else
                            {
                                <MudButton Variant="Variant.Outlined" Color="Color.Primary" DropShadow="false"
                                           StartIcon="@Icons.Material.Rounded.RestoreFromTrash" OnClick="() => SetActiveAsync(true)">Επαναφορά</MudButton>
                            }
                        }
                    </div>
                </EditForm>
            </MudPaper>
        }
    </div>
}

@code {
    // Lookups + list state
    private IReadOnlyList<LookupOption> specialities = Array.Empty<LookupOption>();
    private EmployeeLookups? lookups;
    private List<EmployeeListItem> list = new();

    // Selection / form state
    private int specialityId;
    private bool includeInactive;
    private int selectedId;
    private EmployeeDetail? form;

    // Search box: every active employee (the ShiftEntry list item: Id + "Surname Name — Speciality";
    // written in full because this page's own list uses the Employees item of the same name).
    private IReadOnlyList<Vardiologio.Application.ShiftEntry.EmployeeListItem> searchList =
        Array.Empty<Vardiologio.Application.ShiftEntry.EmployeeListItem>();
    private int searchId;   // employee shown in the search box; 0 = empty

    protected override async Task OnInitializedAsync()
    {
        specialities = await EmployeeService.GetSpecialitiesAsync();
        lookups = await EmployeeService.GetLookupsAsync();
        await ReloadSearchAsync();
    }

    /// <summary>Reloads the names offered by the search box (after a save, a delete or a restore).</summary>
    private async Task ReloadSearchAsync() => searchList = await ShiftService.GetEmployeesAsync();

    /// <summary>
    /// A name was picked in the search box: show that employee's specialty with its whole list,
    /// the employee selected and the form open — the same state as picking the specialty and
    /// then the name by hand. Clearing the box (0) changes nothing else.
    /// </summary>
    private async Task OnSearchPickedAsync(int id)
    {
        searchId = id;
        if (id == 0) return;

        var detail = await EmployeeService.GetAsync(id);
        if (detail is null) return;   // removed in the meantime: nothing to show

        specialityId = detail.SpecialityId;
        await ReloadListAsync();
        selectedId = id;
        form = detail;
    }

    /// <summary>
    /// Options for a form dropdown: active values plus the one currently selected,
    /// so an employee who already has a retired value still shows it (instead of a blank).
    /// </summary>
    private static IEnumerable<LookupOption> Visible(IEnumerable<LookupOption> options, int? currentId) =>
        options.Where(o => o.IsActive || o.Id == currentId);

    /// <summary>Marks retired values in dropdowns (all three lookups are feminine nouns).</summary>
    private static string OptionLabel(LookupOption o) => o.IsActive ? o.Name : $"{o.Name} (ανενεργή)";

    /// <summary>Text of the closed speciality filter: the name of the picked speciality.</summary>
    private string SpecialityName(int id) => id == 0 ? "— επίλεξε —" : NameOf(specialities, id);

    /// <summary>
    /// Text of a closed dropdown: the label of the option with this Id ("—" when nothing is
    /// picked). Without it the box would show the Id it is bound to.
    /// </summary>
    private static string NameOf(IEnumerable<LookupOption> options, int? id) =>
        options.FirstOrDefault(o => o.Id == id) is { } option ? OptionLabel(option) : "—";

    /// <summary>True if the given speciality exists and is active.</summary>
    private bool IsSpecialityActive(int id) => specialities.Any(s => s.Id == id && s.IsActive);

    /// <summary>When the specialty changes, reset selection/form and reload the list.</summary>
    private async Task OnSpecialityChanged()
    {
        searchId = 0;   // the search box no longer describes what is shown
        selectedId = 0;
        form = null;
        await ReloadListAsync();
    }

    /// <summary>Reloads the list for the current specialty + inactive toggle.</summary>
    private async Task ReloadListAsync()
    {
        if (specialityId == 0) { list = new(); return; }
        list = (await EmployeeService.GetBySpecialityAsync(specialityId, includeInactive)).ToList();
    }

    /// <summary>Loads one employee into the edit form.</summary>
    private async Task SelectAsync(int id)
    {
        if (id == 0) return;   // the list reports "nothing selected" as 0
        if (id != searchId) searchId = 0;   // another name picked from the list: empty the search box
        selectedId = id;
        form = await EmployeeService.GetAsync(id);
    }

    /// <summary>Prepares a blank form for a new employee (specialty pre-filled).</summary>
    private void NewEmployee()
    {
        searchId = 0;
        selectedId = 0;
        form = new EmployeeDetail { SpecialityId = specialityId, IsActive = true };
    }

    /// <summary>Creates or updates, then refreshes the list.</summary>
    private async Task SaveAsync()
    {
        if (form is null) return;

        if (form.Id == 0)
        {
            var newId = await EmployeeService.CreateAsync(form);
            selectedId = newId;
            form.Id = newId;
        }
        else
        {
            await EmployeeService.UpdateAsync(form);
        }

        Snackbar.Add("Αποθηκεύτηκε.", Severity.Success);
        await ReloadListAsync();
        await ReloadSearchAsync();   // a new employee or a changed name must be found by the search
    }

    /// <summary>Asks first, then soft-deletes the current employee (can be restored later).</summary>
    private async Task DeleteAsync()
    {
        if (form is null || form.Id == 0) return;

        var confirmed = await Dialogs.ShowMessageBoxAsync(
            "Διαγραφή εργαζομένου",
            $"Ο εργαζόμενος «{form.LastName} {form.FirstName}» θα γίνει ανενεργός. " +
            "Μπορείτε να τον επαναφέρετε από την «Εμφάνιση ανενεργών».",
            yesText: "Διαγραφή", cancelText: "Ακύρωση");
        if (confirmed != true) return;

        await SetActiveAsync(false);
    }

    /// <summary>Soft-delete or restore the current employee.</summary>
    private async Task SetActiveAsync(bool isActive)
    {
        if (form is null || form.Id == 0) return;

        await EmployeeService.SetActiveAsync(form.Id, isActive);
        form.IsActive = isActive;
        Snackbar.Add(isActive ? "Επαναφέρθηκε." : "Διαγράφηκε.", Severity.Success);
        await ReloadListAsync();
        await ReloadSearchAsync();   // the search offers active employees only

        // If it became inactive and we're not showing inactive, clear the form.
        if (!isActive && !includeInactive) { form = null; selectedId = 0; }
    }
}