@inherits LayoutComponentBase
@using Vardiologio.Application.Auth
@inject IUserSession Session
@inject NavigationManager Nav
@implements IDisposable

@* Shell (top bar + side menu + content) shown only when signed in; otherwise the guard below
   redirects to /login. Colours and sizes come from Theme/AppTheme.cs; the few extra rules
   (.app-bar, .app-drawer, ...) are in wwwroot/app.css. *@
@if (Session.IsAuthenticated)
{
    <MudLayout>
        @* Top bar: brand on the left; help, user and sign-out on the right. *@
        <MudAppBar Elevation="0" Class="app-bar">
            @* App icon; a click opens the "about" card (Shared/AboutButton.razor). *@
            <AboutButton />
            <MudText Typo="Typo.h6" Class="brand-name">Βαρδιολόγιο</MudText>
            <MudSpacer />
            @* Context help for the current page ("?"); texts in Shared/HelpContent.razor. *@
            <HelpButton />
            <div class="user-box">
                <MudText Typo="Typo.subtitle2">@Session.Current!.DisplayName</MudText>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                           DropShadow="false" Class="logout-btn" OnClick="Logout">Αποσύνδεση</MudButton>
            </div>
        </MudAppBar>

        @* Side menu: always open (the window is always maximised), placed under the top bar. *@
        <MudDrawer Open="true" Variant="DrawerVariant.Persistent" ClipMode="DrawerClipMode.Always"
                   Elevation="0" Class="app-drawer">
            <MudNavMenu Rounded="true" Margin="Margin.Dense" Class="app-nav">

                @* Every section has the same shape: an icon + small title, then its entries. *@
                <div class="nav-section">
                    <MudIcon Icon="@Icons.Material.Rounded.GridView" Size="Size.Small" />
                    <span>Λειτουργίες</span>
                </div>
                <MudNavLink Href="employees">Εργαζόμενοι</MudNavLink>
                @* Match.All so this is active only at "/", not on every route. *@
                <MudNavLink Href="" Match="NavLinkMatch.All">Προγράμματα</MudNavLink>

                @* Reports and forms together; a thin line separates the three official forms
                   (emblem + signatures) from the plain reports. *@
                <div class="nav-section">
                    <MudIcon Icon="@Icons.Material.Rounded.Description" Size="Size.Small" />
                    <span>Αναφορές - Έντυπα</span>
                </div>
                <MudNavLink Href="export">Συνολική Μηνιαία Σ.Ω.</MudNavLink>
                <MudNavLink Href="individual">Ατομική Μηνιαία</MudNavLink>
                <MudNavLink Href="hours-report">Ωρών Μηνιαία</MudNavLink>
                <MudDivider Class="nav-divider" />
                <MudNavLink Href="shift-table">Πίνακας Βαρδιών Εργασίας</MudNavLink>
                <MudNavLink Href="attendance-report">Παρουσιών Προσωπικού</MudNavLink>
                <MudNavLink Href="overtime-certificate">Ατομικής Βεβαίωσης</MudNavLink>

                <div class="nav-section">
                    <MudIcon Icon="@Icons.Material.Rounded.Tune" Size="Size.Small" />
                    <span>Παράμετροι</span>
                </div>
                <MudNavLink Href="shift-codes">Βαρδιών</MudNavLink>
                <MudNavLink Href="employee-parameters">Εργαζομένων</MudNavLink>
                <MudNavLink Href="hours-parameters">Ωρών</MudNavLink>
                <MudNavLink Href="report-parameters">Αναφορών</MudNavLink>

                @* Administrator-only tools; the entry opens its own sign-in dialog (Shared/DbExportButton.razor). *@
                <div class="nav-section">
                    <MudIcon Icon="@Icons.Material.Rounded.Storage" Size="Size.Small" />
                    <span>Διαχείριση</span>
                </div>
                <DbExportButton />
            </MudNavMenu>
        </MudDrawer>

        <MudMainContent>
            @* "legacy" restores plain-HTML defaults for pages not yet moved to MudBlazor components
               (see the "Legacy pages" block in app.css). *@
            <div class="app-content legacy">
                @Body
            </div>
        </MudMainContent>
    </MudLayout>
}

@code {
    protected override void OnInitialized()
    {
        // React to sign-in/out to refresh the shell.
        Session.Changed += OnChanged;
        // Auth guard: no session -> go to the login page.
        if (!Session.IsAuthenticated) Nav.NavigateTo("/login");
    }
    // Session event may arrive off the UI thread -> marshal back with InvokeAsync.
    private void OnChanged() => InvokeAsync(StateHasChanged);
    private void Logout() { Session.SignOut(); Nav.NavigateTo("/login"); }
    // Unsubscribe to avoid a memory leak (pairs with the subscribe in OnInitialized).
    public void Dispose() => Session.Changed -= OnChanged;
}
