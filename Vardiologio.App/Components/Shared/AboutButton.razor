@* The app icon of the top bar. A click opens the "about" card (Shared/AboutCard.razor) in a
   dialog. Styles: "brand-mark-btn" and "About card" rules in the Shell block of app.css. *@
<button type="button" class="brand-mark brand-mark-btn" title="Σχετικά με την εφαρμογή" @onclick="Open">
    <MudIcon Icon="@Icons.Material.Rounded.CalendarMonth" />
</button>

@* Inline dialog: MudBlazor renders it in MudDialogProvider (Routes.razor), above the whole shell.
   Escape, the close button or a click on the dimmed background closes it. *@
<MudDialog @bind-Visible="open" Options="DialogOptions" ContentClass="about-content">
    <DialogContent>
        <AboutCard />
    </DialogContent>
</MudDialog>

@code {
    /// <summary>Narrow dialog without a title bar; close button, Escape and a click outside close it.</summary>
    private static readonly DialogOptions DialogOptions =
        new() { MaxWidth = MaxWidth.ExtraSmall, FullWidth = true, CloseOnEscapeKey = true, CloseButton = true };

    private bool open;   // dialog visible

    private void Open() => open = true;

}
