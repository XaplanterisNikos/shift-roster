        "attendance-report" => "Αναφορά παρουσιών προσωπικού",
        "overtime-certificate" => "Βεβαίωση ατομική",
        "shift-table" => "Πίνακας βαρδιών εργασίας",
        "shift-codes" => "Παράμετροι βαρδιών",
        "employee-parameters" => "Παράμετροι εργαζομένων",
