@* All help texts of the application, one block per page (keyed by route).
   Formal Greek, addressed to the user in the plural of politeness.
   To add help for a new page: add its title in TitleFor and a block below. *@
@switch (Topic)
{
    case "":
        <p>Στην οθόνη αυτή καταχωρίζεται το μηνιαίο πρόγραμμα βαρδιών κάθε εργαζομένου.</p>

        <h3>Διαδικασία</h3>
        <ol>
            <li>Επιλέξτε <b>έτος</b>, <b>μήνα</b> και <b>εργαζόμενο</b> και πατήστε «Φόρτωση μήνα». Στο πεδίο του εργαζομένου πληκτρολογήστε μέρος του επωνύμου ή του ονόματος· η λίστα περιορίζεται αμέσως και τα γράμματα που ταιριάζουν σημειώνονται με κίτρινο. Τόνοι και κεφαλαία δεν παίζουν ρόλο.</li>
            <li>Για κάθε ημέρα επιλέξτε κωδικό βάρδιας (π.χ. 1–15) ή κωδικό κατάστασης (π.χ. Ρ, Α, Κ). Η επιλογή «—» αφήνει την ημέρα χωρίς καταχώριση.</li>
            <li>Πατήστε «Αποθήκευση». Αποθηκεύονται όλες οι ημέρες του μήνα ταυτόχρονα.</li>
        </ol>

        <h3>Τι ισχύει</h3>
        <ul>
            <li>Η βάρδια υπολογίζεται στην ημέρα στην οποία καταχωρίζεται και στον μήνα της ημέρας αυτής. Για παράδειγμα, ο κωδικός 12 (Παρασκευή 22:00 – Σάββατο 06:00) καταχωρίζεται το Σάββατο.</li>
            <li>Όταν η 1η του μήνα είναι Σάββατο, χρησιμοποιείται ο κωδικός 2 αντί του κωδικού 12.</li>
            <li>Κάθε αλλαγή ελέγχεται αμέσως. Ημέρα με κωδικό που δεν προβλέπεται για το είδος της (καθημερινή, Σάββατο, Κυριακή, αργία) εμφανίζεται με πορτοκαλί χρώμα και σχετικό μήνυμα.</li>
            <li>Τα πλαίσια στο επάνω μέρος εμφανίζουν ανά κατηγορία τις δηλωμένες ώρες, το όριο και τις ώρες που πληρώνονται. Κόκκινη μπάρα και η ένδειξη «Περισσεύουν» σημαίνουν υπέρβαση ορίου· οι ώρες πέραν του ορίου δεν πληρώνονται.</li>
            <li>Δίπλα σε κάθε ημέρα εμφανίζεται το είδος του κωδικού (Ημέρα, Νύχτα ή Κατάσταση). Τα Σαββατοκύριακα και οι αργίες εμφανίζονται με διαφορετικό φόντο.</li>
            <li>Οι προειδοποιήσεις έχουν ενημερωτικό χαρακτήρα και δεν εμποδίζουν την αποθήκευση.</li>
            <li>Εάν φορτώσετε άλλον μήνα ή άλλον εργαζόμενο πριν από την αποθήκευση, οι μη αποθηκευμένες αλλαγές χάνονται.</li>
            <li>Κωδικός που έχει απενεργοποιηθεί εμφανίζεται μόνο στις ημέρες όπου είχε ήδη καταχωριστεί, με την ένδειξη «(ανενεργός)».</li>
        </ul>
        break;

    case "employees":
        <p>Στην οθόνη αυτή τηρείται το μητρώο των εργαζομένων.</p>

        <h3>Διαδικασία</h3>
        <ol>
            <li>Επιλέξτε <b>ειδικότητα</b>. Εμφανίζονται οι εργαζόμενοι της ειδικότητας αυτής.</li>
            <li>Επιλέξτε ένα όνομα για επεξεργασία ή πατήστε «＋ Νέος» για νέο εργαζόμενο.</li>
            <li>Συμπληρώστε επώνυμο, όνομα και ειδικότητα (υποχρεωτικά) και, εφόσον απαιτείται, σύμβαση και θέση. Πατήστε «Αποθήκευση».</li>
        </ol>

        <h3>Τι ισχύει</h3>
        <ul>
            <li>Η «Διαγραφή» απενεργοποιεί τον εργαζόμενο. Δεν εμφανίζεται πλέον στην καταχώριση βαρδιών και στις αναφορές, ενώ οι καταχωρίσεις του διατηρούνται.</li>
            <li>Για να επαναφέρετε εργαζόμενο, ενεργοποιήστε την «Εμφάνιση ανενεργών», επιλέξτε τον και πατήστε «Επαναφορά».</li>
            <li>Νέος εργαζόμενος δεν μπορεί να καταχωριστεί σε ανενεργή ειδικότητα.</li>
            <li>Οι λίστες ειδικοτήτων, συμβάσεων και θέσεων διαμορφώνονται στις «Παράμετροι Εργαζομένων».</li>
        </ul>
        break;

    case "export":
        <p>Στην οθόνη αυτή εκδίδεται ο συνολικός μηνιαίος πίνακας βαρδιών (Σ.Ω.) για όλους τους εργαζομένους.</p>

        <h3>Διαδικασία</h3>
        <ol>
            <li>Η οθόνη ανοίγει με την προεπισκόπηση του τρέχοντος μήνα. Για άλλον μήνα επιλέξτε <b>έτος</b> και <b>μήνα</b>.</li>
            <li>Πατήστε «Προεπισκόπηση» για προβολή στην οθόνη ή «Εξαγωγή Excel» / «Εξαγωγή PDF» για δημιουργία αρχείου.</li>
        </ol>

        <h3>Τι ισχύει</h3>
        <ul>
            <li>Περιλαμβάνονται όλοι οι ενεργοί εργαζόμενοι, με αλφαβητική σειρά.</li>
            <li>Πάνω από τον πίνακα τυπώνονται το εθνόσημο, τα στοιχεία της υπηρεσίας, οι τίτλοι και ο αποδέκτης· κάτω από τον πίνακα το υπόμνημα των κωδικών βάρδιας (από τις «Παραμέτρους Βαρδιών») και οι υπογραφές. Η εκτύπωση γίνεται σε Α4 οριζόντια, σε όσες σελίδες χρειάζονται: τα στοιχεία τυπώνονται μία φορά στην αρχή, οι επικεφαλίδες του πίνακα επαναλαμβάνονται σε κάθε σελίδα, το υπόμνημα και οι υπογραφές μπαίνουν μία φορά στο τέλος. Τα κείμενα αλλάζουν στις «Παραμέτρους Αναφορών», καρτέλα «Συνολική μηνιαία Σ.Ω.».</li>
            <li>Τα αρχεία αποθηκεύονται στον φάκελο «Έγγραφα\Vardiologio\Reports\Monthly-Total\έτος-μήνας» (π.χ. «2026-08 August») με όνομα Monthly_Total_έτος_μήνας και ανοίγουν αυτόματα. Νέα εξαγωγή του ίδιου μήνα αντικαθιστά το προηγούμενο αρχείο.</li>
            <li>Οι στήλες 1–7 δείχνουν πόσες φορές εργάστηκε ο εργαζόμενος σε καθεμία από τις βάρδιες 1–7.</li>
            <li>Οι στήλες «Ημερήσια» και «Κυριακών εξαιρέσιμων» παραμένουν κενές έως ότου οριστεί ο κανόνας υπολογισμού τους.</li>
        </ul>
        break;

    case "individual":
        <p>Στην οθόνη αυτή εμφανίζεται και εκδίδεται το ατομικό φύλλο παρουσιών και ωραρίων ενός εργαζομένου για έναν μήνα.</p>

        <h3>Διαδικασία</h3>
        <ol>
            <li>Επιλέξτε <b>έτος</b>, <b>μήνα</b> και <b>εργαζόμενο</b>.</li>
            <li>Πατήστε «Προεπισκόπηση» για προβολή στην οθόνη, ή «Εξαγωγή Excel» / «Εξαγωγή PDF» για δημιουργία αρχείου.</li>
        </ol>

        <h3>Πίνακας ημερών</h3>
        <ul>
            <li>Το «Είδος εργασίας» είναι ο κωδικός της σύμβασης του εργαζομένου, όπως ορίζεται στους «Εργαζομένους» από τις συμβάσεις των «Παραμέτρων Εργαζομένων». Εάν δεν έχει οριστεί σύμβαση, το πεδίο μένει κενό.</li>
            <li>Για κάθε ημέρα εμφανίζονται το ωράριο της βάρδιας ή ο κωδικός κατάστασης (π.χ. άδεια, ρεπό), ο κωδικός στη στήλη «ΩΡΑΡΙΑ» και η παρουσία.</li>
            <li>Το «Ωράριο υπερωρίας» είναι το τελευταίο τμήμα της βάρδιας, με διάρκεια τις ώρες πέραν του κανονικού ωραρίου που δίνει ο κωδικός την ημέρα εκείνη (π.χ. κωδικός 14: 09:30 – 11:30, κωδικός 13: 04:30 – 06:00). Βάρδια Σαββάτου, Κυριακής ή αργίας είναι υπερωρία στο σύνολό της.</li>
            <li>Στη «Συμπληρωματική εργασία», η στήλη «ΗΜΕΡ.» έχει τις ώρες «Προς συμπλήρωση» και η στήλη «ΚΥΡΙΑΚΗΣ» τις ώρες «Αργίας», όπως ορίζονται για κάθε κωδικό στις «Παράμετροι Βαρδιών».</li>
            <li>Το ωράριο επαναλαμβάνεται στις στήλες ημερήσιου ή νυκτερινού, Δευτέρας – Σαββάτου ή Κυριακών και αργιών· η στήλη «ΩΡ.» δείχνει τις ώρες του κανονικού ωραρίου.</li>
            <li>Η στήλη «ΣΤΑΣΕΙΣ» παραμένει κενή.</li>
        </ul>

        <h3>Συγκεντρωτικά στοιχεία</h3>
        <ul>
            <li>«Δηλωμένες υπερωρίες μήνα»: οι υπερωρίες που προκύπτουν από τους κωδικούς του μήνα, πριν από τα όρια. Στο έντυπο η θέση αυτή είχε τις υπερωρίες από την κάρτα· η εφαρμογή δεν διαθέτει στοιχεία κάρτας.</li>
            <li>«Εργασία προς συμπλήρωση»: δηλωμένες ώρες ανά δεκαπενθήμερο, πριν από τα όρια.</li>
            <li>«Πληρωτέες ώρες»: οι ώρες μετά τα μηνιαία όρια. Είναι οι ίδιες με της «Ατομικής Βεβαίωσης».</li>
        </ul>

        <h3>Αρχεία</h3>
        <ul>
            <li>Το αρχείο αποθηκεύεται στον φάκελο «Έγγραφα\Vardiologio\Reports\Individual-Sheet\έτος-μήνας» (π.χ. «2026-08 August») με όνομα Individual_ΕΠΩΝΥΜΟ_έτος_μήνας, με το επώνυμο σε λατινικούς χαρακτήρες (π.χ. Individual_PAPADOPOULOS_2026_08), και ανοίγει αυτόματα. Νέα εξαγωγή του ίδιου μήνα αντικαθιστά το προηγούμενο αρχείο.</li>
            <li>Η οθόνη είναι μόνο για προβολή και εξαγωγή· οι αλλαγές γίνονται στην «Εισαγωγή προγραμμάτων».</li>
        </ul>
        break;

    case "hours-report":
        <p>Στην οθόνη αυτή εκδίδεται η μηνιαία κατάσταση ωρών όλων των εργαζομένων, ανά κατηγορία αμοιβής.</p>

        <h3>Διαδικασία</h3>
        <ol>
            <li>Επιλέξτε <b>έτος</b> και <b>μήνα</b>.</li>
            <li>Πατήστε «Εμφάνιση» για προβολή στην οθόνη, «Προεπισκόπηση PDF», ή «Εξαγωγή Excel» / «Εξαγωγή PDF» για δημιουργία αρχείου.</li>
        </ol>

        <h3>Τι ισχύει</h3>
        <ul>
            <li>Για κάθε κατηγορία εμφανίζονται: <b>Δηλ.</b> (δηλωμένες ώρες), <b>Πληρ.</b> (ώρες που πληρώνονται) και <b>Περ.</b> (ώρες πέραν του ορίου, οι οποίες δεν πληρώνονται).</li>
            <li>Κατηγορίες: Προς συμπλήρωση (νυχτερινές ώρες του κανονικού ωραρίου), Απλή (υπερωρία καθημερινής ή Σαββάτου), Νυχτερινή (νυχτερινή υπερωρία), Κυριακής και Αργίας.</li>
            <li>Το όριο αργίας του μήνα ισούται με τις ώρες ανά αργία επί τον αριθμό των αργιών του μήνα.</li>
            <li>Οι ώρες «Προς συμπλήρωση» και «Αργίας» μαζί δεν υπερβαίνουν το κοινό όριο· σε περίπτωση υπέρβασης περικόπτονται πρώτα οι ώρες «Προς συμπλήρωση».</li>
            <li>Ο υπολογισμός είναι ο ίδιος με τον πίνακα «Ώρες μήνα» της καταχώρισης βαρδιών.</li>
            <li>Τα αρχεία αποθηκεύονται στον φάκελο «Έγγραφα\Vardiologio\Reports\Monthly-Hours\έτος-μήνας» (π.χ. «2026-08 August») με όνομα Monthly_Hours_έτος_μήνας και ανοίγουν αυτόματα.</li>
            <li>Τα όρια μεταβάλλονται στις «Παράμετροι Ωρών».</li>
        </ul>
        break;

    case "attendance-report":
        <p>Στην οθόνη αυτή εκδίδεται ο μηνιαίος πίνακας παρουσιών προσωπικού, σε δύο αναφορές: μία για τους υπαλλήλους και μία για τη Διεύθυνση.</p>

        <h3>Διαδικασία</h3>
        <ol>
            <li>Επιλέξτε <b>έτος</b> και <b>μήνα</b>.</li>
            <li>Πατήστε «Προεπισκόπηση» για να δείτε τις σελίδες όπως θα εκτυπωθούν· με τις καρτέλες «Υπάλληλοι» / «Διεύθυνση» εναλλάσσεται η αναφορά.</li>
            <li>Πατήστε «Εξαγωγή Excel» ή «Εξαγωγή PDF» για τη δημιουργία των αρχείων.</li>
        </ol>

        <h3>Τι ισχύει</h3>
        <ul>
            <li>Σε κάθε ημέρα εμφανίζεται <b>√</b> όταν έχει καταχωριστεί βάρδια εργασίας, ο <b>κωδικός</b> όταν έχει καταχωριστεί κατάσταση (π.χ. Κ, Ρ, Α) και <b>κενό</b> όταν δεν υπάρχει καταχώριση.</li>
            <li>Ο μήνας εκτυπώνεται ανά δεκαπενθήμερο (1–15 και 16–τέλος μήνα). Κάθε σελίδα φέρει το σήμα, τα στοιχεία της υπηρεσίας, τον τίτλο και τις υπογραφές.</li>
            <li>Στην αναφορά της Διεύθυνσης περιλαμβάνεται ο Διευθυντής: ο εργαζόμενος με θέση εργασίας <b>ΔΙΕΥΘΥΝΤΗΣ</b> ή, εφόσον κανείς δεν έχει τη θέση αυτή, ο εργαζόμενος που έχει οριστεί ως Διευθυντής στα τοπικά στοιχεία της εγκατάστασης. Όλοι οι υπόλοιποι ενεργοί εργαζόμενοι περιλαμβάνονται στην αναφορά των υπαλλήλων.</li>
            <li>Κάθε εξαγωγή (Excel ή PDF) δημιουργεί δύο χωριστά αρχεία, ένα για το προσωπικό και ένα για τη Διεύθυνση.</li>
            <li>Τα αρχεία αποθηκεύονται στον φάκελο «Έγγραφα\Vardiologio\Reports\Staff-Attendance\έτος-μήνας» (π.χ. «2026-08 August») με όνομα Attendance_Staff_έτος_μήνας και Attendance_Directorate_έτος_μήνας και ανοίγουν αυτόματα.</li>
        </ul>
        break;

    case "shift-table":
        <p>Στην οθόνη αυτή εκδίδεται ο επίσημος μηνιαίος «Πίνακας βαρδιών εργασίας προσωπικού», σε μία σελίδα A3 οριζόντια.</p>

        <h3>Διαδικασία</h3>
        <ol>
            <li>Επιλέξτε <b>έτος</b> και <b>μήνα</b>.</li>
            <li>Πατήστε «Προεπισκόπηση» για να δείτε τον πίνακα όπως θα εκτυπωθεί.</li>
            <li>Πατήστε «Εξαγωγή Excel» ή «Εξαγωγή PDF» για τη δημιουργία του αρχείου.</li>
        </ol>

        <h3>Τι ισχύει</h3>
        <ul>
            <li>Περιλαμβάνονται όλοι οι ενεργοί εργαζόμενοι. Σε κάθε ημέρα εμφανίζεται ο καταχωρισμένος κωδικός· τα Σάββατα, οι Κυριακές και οι αργίες είναι σκιασμένα.</li>
            <li>Στη «Βάρδια εργασίας» μετράται πόσες φορές εργάστηκε ο καθένας σε κάθε κωδικό βάρδιας.</li>
            <li>Οι στήλες «Ημερήσια» και «Κυριακών εξαιρέσιμων» δείχνουν τις <b>πληρωτέες</b> ώρες «Προς συμπλήρωση» και «Αργίας», όπως στη βεβαίωση ατομική.</li>
            <li>Το υπόμνημα (κωδικοί και ώρες, καταστάσεις) προκύπτει από τις Παραμέτρους Βαρδιών.</li>
            <li>Ο πίνακας χωράει πάντα σε μία σελίδα A3: όταν χρειάζεται, σμικρύνεται αναλογικά.</li>
            <li>Το αρχείο αποθηκεύεται στον φάκελο «Έγγραφα\Vardiologio\Reports\Shift-Table\έτος-μήνας» (π.χ. «2026-08 August») με όνομα Shift_Table_έτος_μήνας και ανοίγει αυτόματα.</li>
        </ul>
        break;

    case "overtime-certificate":
        <p>Στην οθόνη αυτή εκδίδεται η ατομική «Πιστοποίηση υπερωριακής και λοιπής εργασίας» ενός εργαζομένου για έναν μήνα.</p>

        <h3>Διαδικασία</h3>
        <ol>
            <li>Επιλέξτε <b>έτος</b>, <b>μήνα</b> και <b>εργαζόμενο</b>.</li>
            <li>Πατήστε «Προεπισκόπηση» για να δείτε τη βεβαίωση όπως θα εκτυπωθεί.</li>
            <li>Πατήστε «Εξαγωγή Excel» ή «Εξαγωγή PDF» για τη δημιουργία του αρχείου.</li>
        </ol>

        <h3>Τι ισχύει</h3>
        <ul>
            <li>Οι ώρες είναι οι <b>πληρωτέες</b> ώρες του μήνα, όπως στη στήλη «Πληρ.» της μηνιαίας αναφοράς ωρών: Απογευματινή = Απλή, Νυχτερινή = Νυχτερινή, Κυριακές ημερήσιες = Κυριακής, Νυχτερινή εργασίμων = Προς συμπλήρωση, Κυριακών και εξαιρέσιμων = Αργίας.</li>
            <li>Το ονοματεπώνυμο και η ειδικότητα τυπώνονται όπως είναι καταχωρισμένα στην καρτέλα του εργαζομένου (με κεφαλαία, χωρίς τόνους)· για το πλήρες όνομα, καταχωρίστε το ολόκληρο στο πεδίο «Όνομα».</li>
            <li>Η ένδειξη «Ο/Η Βεβαιών Υπάλληλος» προκύπτει από το όνομα του εργαζομένου.</li>
            <li>Τα πεδία «Αθήνα», «Αρ. Πρωτ.» και «Προς» συμπληρώνονται με το χέρι.</li>
            <li>Το αρχείο αποθηκεύεται στον φάκελο «Έγγραφα\Vardiologio\Reports\Overtime-Certificate\έτος-μήνας» (π.χ. «2026-08 August») με όνομα Certificate_ΕΠΩΝΥΜΟ_έτος_μήνας, με το επώνυμο σε λατινικούς χαρακτήρες (π.χ. Certificate_PAPADOPOULOS_2026_08), και ανοίγει αυτόματα.</li>
        </ul>
        break;

    case "contract-certificate":
        <p>Στην οθόνη αυτή εκδίδεται η συγκεντρωτική «Πιστοποίηση υπερωριακής και λοιπής εργασίας» του μήνα ανά σύμβαση, σε δύο έντυπα: ένα για Μόνιμους και Αορίστου χρόνου (ΙΔΑΧ) και ένα για Ορισμένου χρόνου (ΙΔΟΧ).</p>

        <h3>Διαδικασία</h3>
        <ol>
            <li>Η οθόνη ανοίγει με τον τρέχοντα μήνα. Για άλλον μήνα επιλέξτε <b>έτος</b> και <b>μήνα</b> και πατήστε «Προεπισκόπηση».</li>
            <li>Με τις καρτέλες «Μόνιμοι / ΙΔΑΧ» και «ΙΔΟΧ» εναλλάσσεται το έντυπο.</li>
            <li>Πατήστε «Εξαγωγή Excel» ή «Εξαγωγή PDF» για τη δημιουργία του αρχείου της καρτέλας που είναι ανοικτή.</li>
        </ol>

        <h3>Τι ισχύει</h3>
        <ul>
            <li>Κάθε εργαζόμενος κατατάσσεται με βάση τη <b>σύμβασή</b> του (Εργαζόμενοι → Σύμβαση): Μόνιμος, ΙΔΑΧ ή ΙΔΟΧ. Εργαζόμενος χωρίς μία από τις τρεις συμβάσεις δεν περιλαμβάνεται σε κανένα έντυπο και αναφέρεται σε σημείωση πάνω από την προεπισκόπηση.</li>
            <li>Περιλαμβάνονται όλοι οι ενεργοί εργαζόμενοι της σύμβασης, αλφαβητικά, ακόμη και χωρίς ώρες (κενή γραμμή). Ο Διευθυντής δεν περιλαμβάνεται.</li>
            <li>Οι ώρες είναι οι <b>πληρωτέες</b> ώρες του μήνα, ίδιες με της Ατομικής Βεβαίωσης κάθε εργαζομένου. Μηδενικές ώρες εμφανίζονται ως κενό.</li>
            <li>Ο αύξων αριθμός συνεχίζει από τους Μόνιμους στους Αορίστου χρόνου. Η ομάδα Αορίστου χρόνου αρχίζει σε νέα σελίδα· η επικεφαλίδα του πίνακα επαναλαμβάνεται σε κάθε σελίδα και οι υπογραφές τυπώνονται μία φορά, στο τέλος.</li>
            <li>Τα κείμενα (στοιχεία υπηρεσίας, αποφάσεις, τμήμα, τίτλοι ομάδων, υπογράφοντες) ορίζονται στο «Παράμετροι → Αναφορών», καρτέλα «ΙΔΟΧ / ΙΔΑΧ / Μόνιμοι», και είναι κοινά για τα δύο έντυπα. Το χρώμα των ζωνών ορίζεται στην καρτέλα «Χρώματα».</li>
            <li>Τα πεδία «Αθήνα», «Αρ. Πρωτ.» και «Προς» συμπληρώνονται με το χέρι.</li>
            <li>Το αρχείο αποθηκεύεται στον φάκελο «Έγγραφα\Vardiologio\Reports\Contract-Certificate\έτος-μήνας» (π.χ. «2026-09 September») με όνομα Certificate_Permanent_IDAX_έτος_μήνας ή Certificate_IDOX_έτος_μήνας και ανοίγει αυτόματα.</li>
        </ul>
        break;

    case "shift-codes":
        <p>Στην οθόνη αυτή ορίζονται οι κωδικοί βαρδιών και καταστάσεων και ο τρόπος με τον οποίο υπολογίζονται οι ώρες τους.</p>

        <h3>Διαδικασία</h3>
        <ol>
            <li>Επιλέξτε έναν κωδικό από τη λίστα ή πατήστε «＋ Νέος».</li>
            <li>Συμπληρώστε περιγραφή και, για βάρδιες, ώρα έναρξης και λήξης σε 24ωρη μορφή ΗΗ:ΛΛ (π.χ. 22:00).</li>
            <li>Στον πίνακα «Επιτρεπτές μέρες και κατανομή ωρών» επιλέξτε τα είδη ημερών στα οποία χρησιμοποιείται ο κωδικός και συμπληρώστε τις ώρες ανά κατηγορία.</li>
            <li>Πατήστε «Αποθήκευση».</li>
        </ol>

        <h3>Τι ισχύει</h3>
        <ul>
            <li>Ο κωδικός είναι μοναδικός, δεν μεταβάλλεται μετά τη δημιουργία του και δεν επαναχρησιμοποιείται.</li>
            <li>Όταν η ώρα λήξης είναι μικρότερη από την ώρα έναρξης, η βάρδια λήγει την επόμενη ημέρα (π.χ. 22:00 – 06:00). Η διάρκεια πρέπει να είναι από 1 έως 12 ώρες.</li>
            <li>Οι κωδικοί καταστάσεων (π.χ. Ρ, Α, Κ) δεν έχουν ώρες, επιτρεπτές ημέρες ή κατανομή.</li>
            <li>Το πεδίο «Segment» (Ημέρα/Νύχτα) προτείνεται αυτόματα από τις ώρες και μπορεί να μεταβληθεί χειροκίνητα.</li>
            <li>Στην κατανομή, το κενό κελί σημαίνει μηδέν ώρες. Το σύνολο κάθε ημέρας δεν μπορεί να υπερβαίνει τη διάρκεια της βάρδιας. Η αποεπιλογή ενός είδους ημέρας διαγράφει τις ώρες του.</li>
            <li>Η καταχώριση κωδικού σε ημέρα που δεν έχει επιλεγεί προκαλεί μόνο προειδοποίηση κατά την καταχώριση βαρδιών.</li>
            <li>Εάν ο κωδικός έχει ήδη χρησιμοποιηθεί, η αλλαγή ωρών, Segment, επιτρεπτών ημερών ή κατανομής απαιτεί επιβεβαίωση με δεύτερο πάτημα της «Αποθήκευσης», διότι επηρεάζει αναδρομικά τις υπάρχουσες καταχωρίσεις και τις αναφορές.</li>
            <li>Η «Διαγραφή» απενεργοποιεί τον κωδικό· οι υπάρχουσες καταχωρίσεις διατηρούνται. Η «Επαναφορά» είναι διαθέσιμη με την «Εμφάνιση ανενεργών».</li>
        </ul>
        break;

    case "employee-parameters":
        <p>Στην οθόνη αυτή διαμορφώνονται οι λίστες που χρησιμοποιούνται στο μητρώο εργαζομένων: ειδικότητες, συμβάσεις και θέσεις.</p>

        <h3>Διαδικασία</h3>
        <ol>
            <li>Επιλέξτε την καρτέλα της λίστας που θέλετε να μεταβάλετε.</li>
            <li>Επιλέξτε μια εγγραφή για επεξεργασία ή πατήστε «＋ Νέα».</li>
            <li>Συμπληρώστε το όνομα (και τον κωδικό, στις συμβάσεις) και πατήστε «Αποθήκευση».</li>
        </ol>

        <h3>Τι ισχύει</h3>
        <ul>
            <li>Το όνομα κάθε εγγραφής είναι μοναδικό, ακόμη και σε σχέση με τις ανενεργές. Εάν υπάρχει ήδη ανενεργή εγγραφή με το ίδιο όνομα, προτιμήστε την επαναφορά της.</li>
            <li>Οι συμβάσεις διαθέτουν και σύντομο κωδικό (π.χ. Μ, Α.Χ), ο οποίος είναι επίσης μοναδικός.</li>
            <li>Η «Διαγραφή» απενεργοποιεί την εγγραφή και δεν επιτρέπεται όσο αυτή χρησιμοποιείται από ενεργούς εργαζομένους.</li>
            <li>Η «Επαναφορά» είναι διαθέσιμη με την «Εμφάνιση ανενεργών».</li>
        </ul>
        break;

    case "hours-parameters":
        <p>Στην οθόνη αυτή ορίζονται οι αργίες κάθε έτους και τα μηνιαία όρια ωρών ανά εργαζόμενο.</p>

        <h3>Αργίες</h3>
        <ol>
            <li>Επιλέξτε <b>έτος</b>.</li>
            <li>Πατήστε «＋ Νέα» για νέα αργία ή επιλέξτε μια αργία για επεξεργασία.</li>
            <li>Με το κουμπί «Πρόταση αργιών» προστίθενται οι επίσημες αργίες του έτους που λείπουν, μαζί με τις κινητές (Καθαρά Δευτέρα, Πάσχα, Αγίου Πνεύματος). Οι υπάρχουσες αργίες δεν μεταβάλλονται.</li>
        </ol>
        <ul>
            <li>Ανά ημερομηνία επιτρέπεται μία μόνο αργία.</li>
            <li>Μετά την πρόταση αργιών ελέγξτε τη λίστα, ιδίως τυχόν μετακινήσεις αργιών (π.χ. της Πρωτομαγιάς).</li>
            <li>Η αργία υπερισχύει του Σαββάτου και της Κυριακής: ημέρα που είναι αργία υπολογίζεται ως αργία.</li>
            <li>Κάθε αργία του μήνα αυξάνει το όριο ωρών αργίας του μήνα αυτού.</li>
            <li>Η «Διαγραφή» είναι οριστική και απαιτεί επιβεβαίωση με δεύτερο πάτημα.</li>
        </ul>

        <h3>Όρια ωρών</h3>
        <ul>
            <li>Ορίζονται τα μηνιαία όρια ανά εργαζόμενο για κάθε κατηγορία, οι ώρες αργίας ανά αργία και το κοινό όριο «Προς συμπλήρωση» και «Αργίας».</li>
            <li>Οι ώρες πέραν του ορίου δηλώνονται αλλά δεν πληρώνονται. Σε υπέρβαση του κοινού ορίου περικόπτονται πρώτα οι ώρες «Προς συμπλήρωση».</li>
            <li>Επιτρέπονται τιμές από 0 έως 999,99.</li>
            <li>Η μεταβολή των ορίων εφαρμόζεται σε όλους τους υπολογισμούς, συμπεριλαμβανομένων των προηγούμενων μηνών.</li>
        </ul>
        break;

    case "report-parameters":
        <p>Στην οθόνη αυτή ορίζονται τα κείμενα που τυπώνονται πάνω και κάτω από τον πίνακα των επίσημων εντύπων: στοιχεία υπηρεσίας, τηλέφωνα, e-mail, τίτλοι, αποφάσεις και υπογράφοντες.</p>

        <h3>Διαδικασία</h3>
        <ol>
            <li>Επιλέξτε την <b>καρτέλα</b> του εντύπου (Πίνακας βαρδιών, Παρουσίες προσωπικού, Παρουσίες Διεύθυνσης, Ατομική βεβαίωση, ΙΔΟΧ / ΙΔΑΧ / Μόνιμοι, Συνολική μηνιαία Σ.Ω.).</li>
            <li>Διορθώστε τις γραμμές στην «Κεφαλίδα» (πάνω από τον πίνακα) και στο «Υποσέλιδο» (κάτω από τον πίνακα).</li>
            <li>Πατήστε «Αποθήκευση». Αποθηκεύονται όλες οι γραμμές της καρτέλας ταυτόχρονα.</li>
        </ol>

        <h3>Τι ισχύει</h3>
        <ul>
            <li>Κάθε καρτέλα έχει τα δικά της κείμενα και αποθηκεύεται χωριστά. Αλλαγή που αφορά περισσότερα έντυπα (π.χ. νέο τηλέφωνο) γίνεται σε κάθε καρτέλα.</li>
            <li>Γραμμές δεν προστίθενται και δεν διαγράφονται. Γραμμή που μένει κενή δεν τυπώνεται· οι κενές γραμμές στις υπογραφές είναι διαθέσιμες για επιπλέον τίτλο ή ιδιότητα.</li>
            <li>Ο μήνας, το έτος και οι ημερομηνίες της περιόδου συμπληρώνονται αυτόματα και δεν γράφονται στα κείμενα.</li>
            <li>Η μορφή κάθε γραμμής (έντονα, μέγεθος) ακολουθεί τη θέση της στο έντυπο και δεν αλλάζει.</li>
            <li>Η «Επαναφορά τελευταίας αλλαγής» επαναφέρει τα κείμενα της καρτέλας όπως ήταν πριν από την τελευταία αποθήκευση. Δεύτερο πάτημα φέρνει ξανά τα νεότερα κείμενα.</li>
            <li>Οι αλλαγές ισχύουν από την επόμενη εκτύπωση, για κάθε μήνα. Αρχεία που έχουν ήδη παραχθεί δεν μεταβάλλονται.</li>
            <li>Τα κείμενα αποθηκεύονται στη βάση του υπολογιστή αυτού· άλλος υπολογιστής έχει τα δικά του.</li>
        </ul>

        <h3>Χρώματα</h3>
        <ul>
            <li>Η καρτέλα «Χρώματα» δείχνει, ανά αναφορά, κάθε χρώμα και τα πεδία που χρωματίζει (π.χ. στήλες Σαββάτου, ώρες που περισσεύουν).</li>
            <li>Πατήστε στο χρωματιστό πλαίσιο για να διαλέξετε άλλο χρώμα και μετά «Αποθήκευση». Το ίδιο χρώμα ισχύει στην οθόνη, στο Excel και στο PDF.</li>
            <li>Χρώματα δεν προστίθενται και δεν διαγράφονται. Όταν ένα χρώμα έχει αλλάξει, η ένδειξη «αρχικό χρώμα» το επαναφέρει στο χρώμα της εφαρμογής· ισχύει μετά την «Αποθήκευση».</li>
            <li>Η «Επαναφορά τελευταίας αλλαγής» επαναφέρει όλα τα χρώματα όπως ήταν πριν από την τελευταία αποθήκευση.</li>
        </ul>
        break;

    default:
        <p>Δεν υπάρχουν ακόμη οδηγίες για την οθόνη αυτή.</p>
        break;
}

