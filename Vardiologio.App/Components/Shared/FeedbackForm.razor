@using Microsoft.JSInterop
@using Vardiologio.Infrastructure.Files
@inject IJSRuntime Js
@inject ISnackbar Snackbar

@* Message to the developer: kind (error / addition), the menu it is about, the sender's name and
   the text. "Αποστολή email" is a mailto: link, so the user's own mail program opens with the
   recipient, subject and text filled in; the address is outside the app's origin, so BlazorWebView
   hands it to Windows (same as the e-mail link of Shared/AboutCard.razor).
   A mailto: link cannot carry attachments: for an error, a note asks the user to attach the log
   files by hand and shows the folder they are in.
   Some mail programs open the new message without the subject or the text (seen with the new
   Outlook); "Αντιγραφή" puts recipient, subject and text on the clipboard as a way around it.
   Shown in the side drawer of Layout/MainLayout.razor. *@
<div class="feedback-form">
    @* Kind of message: exactly one of the two. *@
    <MudRadioGroup T="string" @bind-Value="kind">
        <MudRadio T="string" Value="@KindError" Color="Color.Error" Dense="true">Σφάλμα</MudRadio>
        <MudRadio T="string" Value="@KindAddition" Color="Color.Primary" Dense="true">Προσθήκη</MudRadio>
    </MudRadioGroup>

    @* The menu the message is about; it becomes the subject of the e-mail. *@
    <MudSelect T="string" Label="Μενού" Value="@menu" ValueChanged="OnMenuPicked" Variant="Variant.Outlined"
               Margin="Margin.Dense">
        @foreach (var m in Menus)
        {
            <MudSelectItem T="string" Value="@m.Label">@m.Label</MudSelectItem>
        }
    </MudSelect>

    @* Typed by the sender (not the sign-in name); required. *@
    <MudTextField T="string" Label="Ονοματεπώνυμο" @bind-Value="name" Immediate="true" Required="true"
                  Variant="Variant.Outlined" Margin="Margin.Dense" MaxLength="80" />

    @* Immediate => the send button and the mailto: link follow every keystroke. *@
    <MudTextField T="string" Label="Πείτε μου το πρόβλημα που έχετε" @bind-Value="text" Immediate="true"
                  Variant="Variant.Outlined" Lines="9" MaxLength="@MaxTextLength" Counter="@MaxTextLength" />

    @if (kind == KindError)
    {
        <MudAlert Severity="Severity.Info" Dense="true" Class="feedback-note">
            Καλό είναι να επισυνάψετε στο email και τα αρχεία καταγραφής σφαλμάτων (logs).
            Θα τα βρείτε στον φάκελο:
            <span class="feedback-path">@AppFolders.Logs</span>
        </MudAlert>
    }

    @if (!CanSend)
    {
        <div class="feedback-hint">Συμπληρώστε ονοματεπώνυμο και κείμενο για να στείλετε το μήνυμα.</div>
    }

    @* Actions, one under the other: send, copy (the way around a mail program that drops the
       text), clear. *@
    <div class="feedback-actions">
        @* A link button only when the form is complete; a disabled plain button otherwise. *@
        @if (CanSend)
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary" DropShadow="false" FullWidth="true"
                       Href="@MailtoUrl()" StartIcon="@Icons.Material.Rounded.Send">Αποστολή email</MudButton>
        }
        else
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary" DropShadow="false" FullWidth="true"
                       Disabled="true" StartIcon="@Icons.Material.Rounded.Send">Αποστολή email</MudButton>
        }
        <MudButton Variant="Variant.Outlined" Color="Color.Primary" FullWidth="true" Disabled="@(!CanSend)"
                   StartIcon="@Icons.Material.Rounded.ContentCopy"
                   title="Αντιγραφή παραλήπτη, θέματος και κειμένου, για επικόλληση σε email"
                   OnClick="CopyAsync">Αντιγραφή μηνύματος</MudButton>
        <MudButton Variant="Variant.Text" FullWidth="true" OnClick="Clear">Καθαρισμός</MudButton>
    </div>
</div>

@code {
    private const string KindError = "Σφάλμα";
    private const string KindAddition = "Προσθήκη";
    private const string GeneralMenu = "Γενικά";

    /// <summary>
    /// Longest message text. A mailto: address has a length limit that depends on the mail program,
    /// and every Greek letter takes six characters in it; longer texts can be continued in the e-mail.
    /// </summary>
    private const int MaxTextLength = 1000;

    /// <summary>
    /// The entries of the picker: page route (null = no page of its own) and label, in side-menu order.
    /// Keep in step with the side menu of Layout/MainLayout.razor.
    /// </summary>
    private static readonly (string? Route, string Label)[] Menus =
    [
        (null, GeneralMenu),
        ("employees", "Λειτουργίες - Εργαζόμενοι"),
        ("", "Λειτουργίες - Προγράμματα"),
        ("export", "Αναφορές - Συνολική Μηνιαία Σ.Ω."),
        ("individual", "Αναφορές - Ατομική Μηνιαία"),
        ("hours-report", "Αναφορές - Ωρών Μηνιαία"),
        ("shift-table", "Έντυπα - Πίνακας Βαρδιών Εργασίας"),
        ("attendance-report", "Έντυπα - Παρουσιών Προσωπικού"),
        ("overtime-certificate", "Έντυπα - Ατομικής Βεβαίωσης"),
        ("contract-certificate", "Έντυπα - ΙΔΟΧ / ΙΔΑΧ / Μόνιμοι"),
        ("shift-codes", "Παράμετροι - Βαρδιών"),
        ("employee-parameters", "Παράμετροι - Εργαζομένων"),
        ("hours-parameters", "Παράμετροι - Ωρών"),
        ("report-parameters", "Παράμετροι - Αναφορών"),
        (null, "Διαχείριση - Εισαγωγή / Εξαγωγή βάσης"),
        (null, "Σύνδεση")
    ];

    /// <summary>Route of the current page; preselects its menu until the user picks one.</summary>
    [Parameter] public string Route { get; set; } = "";

    private string kind = KindError;
    private string menu = GeneralMenu;
    private bool menuPicked;        // the user chose a menu: stop following the current page
    private string name = "";
    private string text = "";

    /// <summary>Both the sender's name and the text are required.</summary>
    private bool CanSend => !string.IsNullOrWhiteSpace(name) && !string.IsNullOrWhiteSpace(text);

    protected override void OnParametersSet()
    {
        if (!menuPicked) menu = MenuOf(Route);
    }

    /// <summary>Menu label of a page route; "Γενικά" for a route that is not in the list.</summary>
    private static string MenuOf(string route)
    {
        foreach (var m in Menus)
            if (m.Route == route) return m.Label;
        return GeneralMenu;
    }

    private void OnMenuPicked(string value)
    {
        menu = value;
        menuPicked = true;
    }

    /// <summary>Empties the text and returns the menu to the current page; kind and name stay.</summary>
    private void Clear()
    {
        text = "";
        menuPicked = false;
        menu = MenuOf(Route);
    }

    /// <summary>Subject of the e-mail: kind and menu, e.g. "Σφάλμα - Αναφορές - Ατομική Μηνιαία".</summary>
    private string Subject => $"{kind} - {menu}";

    /// <summary>Text of the e-mail: the message, then the sender's name and the application version.</summary>
    private string Body()
    {
        // Mail programs expect CRLF line ends in the body.
        var message = text.Trim().Replace("\r\n", "\n").Replace("\n", "\r\n");
        return $"{message}\r\n\r\n{name.Trim()}\r\nΒαρδιολόγιο {AppInfo.Version}";
    }

    /// <summary>The mailto: address: recipient, subject and text.</summary>
    private string MailtoUrl() =>
        $"mailto:{AppInfo.AuthorEmail}?subject={Uri.EscapeDataString(Subject)}&body={Uri.EscapeDataString(Body())}";

    /// <summary>
    /// Puts recipient, subject and text on the clipboard, to paste into any mail program or webmail.
    /// </summary>
    private async Task CopyAsync()
    {
        var all = $"Προς: {AppInfo.AuthorEmail}\r\nΘέμα: {Subject}\r\n\r\n{Body()}";
        try
        {
            await Js.InvokeVoidAsync("navigator.clipboard.writeText", all);
            Snackbar.Add("Το μήνυμα αντιγράφηκε. Επικολλήστε το στο email σας.", Severity.Success);
        }
        catch (JSException)
        {
            // The browser refused the clipboard (e.g. the window lost focus).
            Snackbar.Add("Η αντιγραφή δεν έγινε. Δοκιμάστε ξανά.", Severity.Warning);
        }
    }
}
