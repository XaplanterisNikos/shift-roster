@using Vardiologio.Application.Parameters
@using Microsoft.AspNetCore.Components.Forms
@inject ILookupService LookupService
@inject ISnackbar Snackbar
@inject IDialogService Dialogs

@* Master-detail CRUD for ONE lookup table (chosen by Kind), same shape as Pages/Employees.razor.
   Used once per tab in EmployeeParameters.razor; every tab gets its own fresh instance
   (no stale list/form carried across kinds). Styles: "Master-detail" block in app.css. *@
<div class="md-bar">
    <MudButton Variant="Variant.Filled" Color="Color.Primary" DropShadow="false"
               StartIcon="@Icons.Material.Rounded.Add" OnClick="NewItem">Νέα</MudButton>

    <MudSwitch T="bool" @bind-Value="includeInactive" @bind-Value:after="ReloadListAsync"
               Color="Color.Primary" Label="Εμφάνιση ανενεργών" />
</div>

<div class="md-grid">
    @* LEFT: rows of this lookup. The list marks the row of selectedId. *@
    <MudPaper Elevation="0" Class="md-list">
        <div class="md-list-head">@list.Count @(list.Count == 1 ? "εγγραφή" : "εγγραφές")</div>
        @if (list.Count == 0)
        {
            <MudText Typo="Typo.body2" Class="md-list-empty">Καμία εγγραφή.</MudText>
        }
        else
        {
            <MudList T="int" SelectedValue="selectedId" SelectedValueChanged="SelectById"
                     Color="Color.Primary" Dense="true">
                @foreach (var x in list)
                {
                    <MudListItem T="int" Value="@x.Id" Class="@(x.IsActive ? null : "md-inactive")">
                        <span class="md-item">
                            <span>@Label(x)</span>
                            @if (!x.IsActive)
                            {
                                <span class="md-tag">ανενεργή</span>
                            }
                        </span>
                    </MudListItem>
                }
            </MudList>
        }
    </MudPaper>

    @* RIGHT: create/edit form *@
    @if (form is null)
    {
        <MudPaper Elevation="0" Class="empty-state md-hint">
            <MudIcon Icon="@Icons.Material.Rounded.TouchApp" Size="Size.Large" />
            <MudText Typo="Typo.body1">Επιλέξτε εγγραφή από τη λίστα ή πατήστε «Νέα».</MudText>
        </MudPaper>
    }
    else
    {
        <MudPaper Elevation="0" Class="md-form">
            <EditForm Model="form" OnValidSubmit="SaveAsync">
                <DataAnnotationsValidator />

                <div class="md-form-head">
                    <MudText Typo="Typo.h6">@(form.Id == 0 ? "Νέα εγγραφή" : "Επεξεργασία")</MudText>
                    @if (!form.IsActive)
                    {
                        <span class="md-tag">ανενεργή</span>
                    }
                </div>

                <div class="md-fields">
                    @if (HasCode)
                    {
                        <MudTextField T="string" Label="Κωδικός" @bind-Value="form.Code" @bind-Value:after="ClearError"
                                      For="@(() => form.Code)" Variant="Variant.Outlined" Margin="Margin.Dense" />
                    }

                    <MudTextField T="string" Label="Όνομα" @bind-Value="form.Name" @bind-Value:after="ClearError"
                                  For="@(() => form.Name)" Variant="Variant.Outlined" Margin="Margin.Dense" />
                </div>

                @if (errorMessage is not null)
                {
                    <MudAlert Severity="Severity.Error" Dense="true" Class="md-alert">@errorMessage</MudAlert>
                }

                <div class="md-actions">
                    <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" DropShadow="false"
                               StartIcon="@Icons.Material.Rounded.Save">Αποθήκευση</MudButton>
                    <MudButton Variant="Variant.Text" OnClick="CancelEdit">Ακύρωση</MudButton>

                    @if (form.Id != 0)
                    {
                        @if (form.IsActive)
                        {
                            <MudButton Variant="Variant.Outlined" Color="Color.Error" DropShadow="false"
                                       StartIcon="@Icons.Material.Rounded.Delete" OnClick="() => SetActiveAsync(false)">Διαγραφή</MudButton>
                        }
                        else
                        {
                            <MudButton Variant="Variant.Outlined" Color="Color.Primary" DropShadow="false"
                                       StartIcon="@Icons.Material.Rounded.RestoreFromTrash" OnClick="() => SetActiveAsync(true)">Επαναφορά</MudButton>
                        }
                    }
                </div>
            </EditForm>
        </MudPaper>
    }
</div>

@code {
    /// <summary>Which lookup table this editor manages.</summary>
    [Parameter, EditorRequired] public LookupKind Kind { get; set; }

    private List<LookupItem> list = new();

    private bool includeInactive;
    private int selectedId;
    private LookupItem? form;
    private string? errorMessage;

    /// <summary>Only employment types have a short Code (shown in the roster grid).</summary>
    private bool HasCode => Kind == LookupKind.EmploymentType;

    protected override async Task OnInitializedAsync()
    {
        await ReloadListAsync();
    }

    /// <summary>Reloads the list for the current inactive toggle.</summary>
    private async Task ReloadListAsync()
    {
        list = (await LookupService.GetAllAsync(Kind, includeInactive)).ToList();
    }

    /// <summary>List label: "Code — Name" for employment types, just Name otherwise.</summary>
    private string Label(LookupItem x) => HasCode ? $"{x.Code} — {x.Name}" : x.Name;

    /// <summary>Called by the list with the Id of the clicked row (0 = nothing selected).</summary>
    private void SelectById(int id)
    {
        if (list.FirstOrDefault(x => x.Id == id) is { } item) Select(item);
    }

    /// <summary>
    /// Loads a row into the form as a COPY, so unsaved edits never show up in the list
    /// (the list row object is not touched until a successful save + reload).
    /// </summary>
    private void Select(LookupItem x)
    {
        errorMessage = null;
        selectedId = x.Id;
        form = new LookupItem { Id = x.Id, Code = x.Code, Name = x.Name, IsActive = x.IsActive };
    }

    /// <summary>Prepares a blank form for a new row.</summary>
    private void NewItem()
    {
        errorMessage = null;
        selectedId = 0;
        form = new LookupItem { IsActive = true };
    }

    private void ClearError() => errorMessage = null;

    /// <summary>Creates or updates after the kind-specific and uniqueness checks (no exceptions).</summary>
    private async Task SaveAsync()
    {
        if (form is null) return;
        errorMessage = null;

        var name = form.Name.Trim();

        if (HasCode)
        {
            // Code is required only for employment types, so it is checked here, not by an attribute.
            if (string.IsNullOrWhiteSpace(form.Code))
            {
                errorMessage = "Ο κωδικός είναι υποχρεωτικός.";
                return;
            }

            var code = form.Code.Trim();
            if (await LookupService.EmploymentTypeCodeExistsAsync(code, form.Id))
            {
                errorMessage = $"Ο κωδικός \"{code}\" χρησιμοποιείται ήδη (ενεργός ή ανενεργός).";
                return;
            }
        }

        if (await LookupService.NameExistsAsync(Kind, name, form.Id))
        {
            // Unique across inactive rows too: point the user to "restore" instead of a duplicate.
            errorMessage = $"Το όνομα \"{name}\" υπάρχει ήδη. Αν είναι ανενεργό, κάνε επαναφορά.";
            return;
        }

        if (form.Id == 0)
        {
            var newId = await LookupService.CreateAsync(Kind, form);
            selectedId = newId;
            form.Id = newId;
        }
        else
        {
            await LookupService.UpdateAsync(Kind, form);
        }

        Snackbar.Add("Αποθηκεύτηκε.", Severity.Success);
        await ReloadListAsync();
    }

    /// <summary>
    /// Soft-delete (blocked while active employees use it, otherwise asked first) or restore.
    /// </summary>
    private async Task SetActiveAsync(bool isActive)
    {
        if (form is null || form.Id == 0) return;
        errorMessage = null;

        if (!isActive)
        {
            // Check-then-act: a value in use by active employees cannot be deactivated.
            var inUse = await LookupService.CountActiveEmployeesAsync(Kind, form.Id);
            if (inUse > 0)
            {
                errorMessage = $"Χρησιμοποιείται από {inUse} ενεργούς εργαζόμενους. " +
                               "Άλλαξέ τους πρώτα και μετά κάνε διαγραφή.";
                return;
            }

            // Asked after the check, so the user is not asked about something that cannot be done.
            var confirmed = await Dialogs.ShowMessageBoxAsync(
                "Διαγραφή εγγραφής",
                $"Είστε σίγουροι; Η εγγραφή «{form.Name}» θα γίνει ανενεργή. " +
                "Μπορείτε να την επαναφέρετε από την «Εμφάνιση ανενεργών».",
                yesText: "Διαγραφή", cancelText: "Ακύρωση");
            if (confirmed != true) return;
        }

        await LookupService.SetActiveAsync(Kind, form.Id, isActive);
        form.IsActive = isActive;
        Snackbar.Add(isActive ? "Επαναφέρθηκε." : "Διαγράφηκε.", Severity.Success);
        await ReloadListAsync();

        // If it became inactive and we're not showing inactive, clear the form.
        if (!isActive && !includeInactive) { form = null; selectedId = 0; }
    }

    /// <summary>Closes the form without saving.</summary>
    private void CancelEdit()
    {
        form = null;
        selectedId = 0;
        errorMessage = null;
    }
}
