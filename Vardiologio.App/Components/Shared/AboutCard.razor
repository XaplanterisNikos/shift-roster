@* The "about" card: application name and version, and who made it, with links to e-mail,
   LinkedIn and GitHub. The addresses are outside the app's origin, so BlazorWebView opens them
   in the default browser / mail program instead of inside the app window.
   Shown in the dialog of Shared/AboutButton.razor. *@
<div class="about-card">
    @* Application: icon, name, version. *@
    <div class="brand-mark brand-mark-lg">
        <MudIcon Icon="@Icons.Material.Rounded.CalendarMonth" Size="Size.Large" />
    </div>
    <MudText Typo="Typo.h5" Class="about-app">Βαρδιολόγιο</MudText>
    <div class="about-version">Shift-Roster · έκδοση @AppInfo.Version</div>

    <MudDivider Class="about-divider" />

    @* Creator. *@
    <div class="about-label">Σχεδιασμός και ανάπτυξη</div>
    <div class="about-person">
        <MudAvatar Color="Color.Primary" Size="Size.Large">ΝΞ</MudAvatar>
        <div>
            <MudText Typo="Typo.h6">@AppInfo.AuthorName</MudText>
            <MudText Typo="Typo.body2" Class="about-role">Προγραμματιστής .NET</MudText>
        </div>
    </div>

    @* One row per way to reach the creator: icon, kind, address. *@
    <div class="about-links">
        <a class="about-link" href="mailto:@AppInfo.AuthorEmail">
            <MudIcon Icon="@Icons.Material.Rounded.Email" />
            <span class="about-link-text"><b>E-mail</b>@AppInfo.AuthorEmail</span>
        </a>
        <a class="about-link" href="@AppInfo.LinkedInUrl">
            <MudIcon Icon="@Icons.Custom.Brands.LinkedIn" />
            <span class="about-link-text"><b>LinkedIn</b>@Short(AppInfo.LinkedInUrl)</span>
        </a>
        <a class="about-link" href="@AppInfo.GitHubUrl">
            <MudIcon Icon="@Icons.Custom.Brands.GitHub" />
            <span class="about-link-text"><b>GitHub</b>@Short(AppInfo.GitHubUrl)</span>
        </a>
    </div>
</div>

@code {
    /// <summary>An address as shown on the card: without "https://" and a trailing slash.</summary>
    private static string Short(string url) => url.Replace("https://", "").Replace("www.", "").TrimEnd('/');
}
