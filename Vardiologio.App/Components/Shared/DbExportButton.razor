@* Side-menu entry "Εισαγωγή / Εξαγωγή βάσης" and its administrator sign-in dialog.
   Placeholder stage: the dialog exists so users can see the feature is coming,
   but every attempt is refused. The typed password is never checked, stored or
   logged; it is cleared after each attempt and when the dialog closes.
   Next stage: verify against an admin PBKDF2 hash (same scheme as UserStore)
   and, on success, run the actual database export. *@
<MudNavLink OnClick="Open">Εισαγωγή / Εξαγωγή βάσης</MudNavLink>

@* Inline dialog: MudBlazor renders it in MudDialogProvider (Routes.razor), above the whole shell.
   Escape or a click on the dimmed background closes it (-> OnVisibleChanged). *@
<MudDialog Visible="open" VisibleChanged="OnVisibleChanged" Options="DialogOptions">
    <TitleContent>
        <MudText Typo="Typo.h6">Εισαγωγή / Εξαγωγή βάσης</MudText>
    </TitleContent>
    <DialogContent>
        <div class="admin-fields">
            <MudText Typo="Typo.body2">Η λειτουργία είναι διαθέσιμη μόνο στον διαχειριστή.</MudText>
            @* Fixed administrator account name; not editable. *@
            <MudTextField T="string" Label="Χρήστης" Value="@AdminUserName" ReadOnly="true"
                          Variant="Variant.Outlined" tabindex="-1" />
            @* Immediate => value is current when Enter is pressed; autocomplete off => no saved passwords offered. *@
            <MudTextField @ref="passwordField" T="string" Label="Κωδικός" @bind-Value="password" Immediate="true"
                          InputType="InputType.Password" Variant="Variant.Outlined" AutoFocus="true"
                          OnKeyDown="OnKey" autocomplete="off" />
            @if (denied)
            {
                <MudAlert Severity="Severity.Error" Dense="true">Δεν έχετε πρόσβαση εισόδου.</MudAlert>
            }
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Close">Ακύρωση</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" DropShadow="false" OnClick="Submit">Είσοδος</MudButton>
    </DialogActions>
</MudDialog>

@code {
    /// <summary>Administrator account name shown in the dialog.</summary>
    private const string AdminUserName = "admin";

    /// <summary>Narrow dialog; Escape closes it.</summary>
    private static readonly DialogOptions DialogOptions =
        new() { MaxWidth = MaxWidth.ExtraSmall, FullWidth = true, CloseOnEscapeKey = true };

    /// <summary>Raised with true when the dialog opens and false when it closes (MainLayout colours the app icon).</summary>
    [Parameter] public EventCallback<bool> OpenChanged { get; set; }

    private bool open;          // dialog visible
    private bool denied;        // show the "no access" message
    private string password = "";
    private MudTextField<string>? passwordField;

    /// <summary>Opens the dialog in a clean state (the password box takes focus by itself: AutoFocus).</summary>
    private Task Open()
    {
        password = "";
        denied = false;
        open = true;
        return OpenChanged.InvokeAsync(true);
    }

    /// <summary>Closes the dialog and discards anything typed.</summary>
    private Task Close()
    {
        open = false;
        denied = false;
        password = "";
        return OpenChanged.InvokeAsync(false);
    }

    /// <summary>Raised by the dialog when it closes itself (Escape, click on the background).</summary>
    private Task OnVisibleChanged(bool visible) => visible ? Task.CompletedTask : Close();

    /// <summary>Enter submits (Escape is handled by the dialog itself).</summary>
    private async Task OnKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await Submit();
    }

    /// <summary>
    /// Placeholder: every attempt is refused. The password is cleared immediately
    /// and focus returns to the box so the user can try again or cancel.
    /// </summary>
    private async Task Submit()
    {
        denied = true;
        password = "";
        if (passwordField is not null) await passwordField.FocusAsync();
    }
}
